import Lean
import Grothendieck.Attr
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The declarations by source

Issue #39, step 3: the declarations of this repository listed by the place in Grothendieck's notes
that they formalise, for the site and the article. Run after `lake build`:

    lake env lean --run scripts/SourceIndex.lean <root module> <output file> <module prefix>...

Imports the root module and reads, for the declarations of the modules whose name starts with one
of the prefixes, the attributes `@[montpellier "cote, page"]` and `@[buffalo "entry"]` of
`Grothendieck/Attr.lean` and Stacks' `@[ega …]` and `@[sga …]`
(`StacksCore.Tactic.EgaSgaAttribute`). The report (Markdown) has three parts: the Montpellier
notes by cote, the Buffalo lectures by entry, and the EGA and SGA items.
-/

open Lean Grothendieck.Source

def moduleOf (env : Environment) (n : Name) : Option Name :=
  (env.getModuleIdxFor? n).map fun idx => env.header.moduleNames[idx.toNat]!

def hasPrefix (prefixes : List Name) (mod : Name) : Bool :=
  prefixes.any fun p => p.isPrefixOf mod

/-- The leading number of a string, for sorting `"136"`, `"156-1"`, `"9"` in numerical order. -/
def leadingNat (s : String) : Nat :=
  (s.toList.takeWhile Char.isDigit |> String.ofList).toNat?.getD 0

/-- Sort key of a cote: its number, then the rest (`156-1` before `156-2`). -/
def coteLt (a b : String) : Bool :=
  leadingNat a < leadingNat b || (leadingNat a == leadingNat b && a < b)

/-- A Buffalo entry `VIDEO-NUMBER`: the video and the number. -/
def splitEntry (e : String) : String × Nat :=
  let parts := e.splitOn "-"
  ("-".intercalate parts.dropLast, (parts.getLastD "").toNat?.getD 0)

/-- What comes after the cote in a Montpellier reference: the page. -/
def page (ref : String) : String :=
  ", ".intercalate ((ref.splitOn ", ").drop 1)

/-- A sort key for EGA/SGA references: volumes in order, then numbers component by
component. -/
def refKey (r : String) : List String × List Nat :=
  let words := (r.splitOn " ").filter (· ≠ "")
  let num := words.getLastD ""
  (words.dropLast, (num.splitOn ".").map fun p => leadingNat p)

def refLt (a b : String) : Bool :=
  let (va, na) := refKey a
  let (vb, nb) := refKey b
  let volOrder := ["0", "I", "II", "III", "IV", "1", "2", "3", "4", "4½", "5", "6", "7"]
  let vidx (v : List String) : Nat := volOrder.idxOf (v.headD "")
  vidx va < vidx vb || (vidx va == vidx vb && (va.toString < vb.toString ||
    (va == vb && (na < nb || (na == nb && a < b)))))

unsafe def main (args : List String) : IO UInt32 := do
  match args with
  | root :: out :: prefixStrs =>
    let prefixes := prefixStrs.map String.toName
    initSearchPath (← findSysroot)
    enableInitializersExecution
    let env ← importModules #[{ module := root.toName }] {} (loadExts := true)
    let ours (n : Name) : Option Name :=
      (moduleOf env n).bind fun m => if hasPrefix prefixes m then some m else none
    let sources := (allEntries env).filterMap fun e => (ours e.declName).map (e, ·)
    let egaSga := (Stacks.EgaSga.allRefs env).filterMap fun r => (ours r.declName).map (r, ·)
    let montpellier := sources.filter (·.1.work == .montpellier)
    let buffalo := sources.filter (·.1.work == .buffalo)
    let mut md := "# The declarations by source\n\n"
    md := md ++ s!"Generated by `scripts/SourceIndex.lean` from `{root}`, prefixes " ++
      s!"{", ".intercalate (prefixStrs.map (s!"`{·}`"))}.\n\n"
    let cotes := (montpellier.map fun (e, _) => cote e.ref).toList.eraseDups
    let videos := (buffalo.map fun (e, _) => (splitEntry e.ref).1).toList.eraseDups
    md := md ++ s!"- Montpellier notes (`@[montpellier]`): {montpellier.size} declarations, " ++
      s!"{cotes.length} cotes.\n"
    md := md ++ s!"- Buffalo lectures (`@[buffalo]`): {buffalo.size} declarations, " ++
      s!"{videos.length} videos.\n"
    md := md ++ s!"- EGA and SGA items (`@[ega]`, `@[sga]`): {egaSga.size} references.\n\n"
    -- Montpellier, by cote.
    md := md ++ "## Montpellier notes, by cote\n\n"
    let cotes := cotes.toArray.qsort coteLt
    for c in cotes do
      let rows := (montpellier.filter fun (e, _) => cote e.ref == c).qsort fun a b =>
        leadingNat (page a.1.ref) < leadingNat (page b.1.ref) ||
          (leadingNat (page a.1.ref) == leadingNat (page b.1.ref) &&
            a.1.declName.toString < b.1.declName.toString)
      md := md ++ s!"### Cote {c}\n\n| Page | Declaration | Module |\n|---|---|---|\n"
      for (e, m) in rows do
        md := md ++ s!"| {page e.ref} | `{e.declName}` | `{m}` |\n"
      md := md ++ "\n"
    -- Buffalo, by entry.
    md := md ++ "## Buffalo lectures, by entry\n\n"
    let videos := videos.toArray.qsort (· < ·)
    for v in videos do
      let rows := (buffalo.filter fun (e, _) => (splitEntry e.ref).1 == v).qsort fun a b =>
        (splitEntry a.1.ref).2 < (splitEntry b.1.ref).2 ||
          ((splitEntry a.1.ref).2 == (splitEntry b.1.ref).2 &&
            a.1.declName.toString < b.1.declName.toString)
      md := md ++ s!"### Video `{v}`\n\n| Entry | Declaration | Module |\n|---|---|---|\n"
      for (e, m) in rows do
        md := md ++ s!"| {(splitEntry e.ref).2} | `{e.declName}` | `{m}` |\n"
      md := md ++ "\n"
    -- EGA and SGA.
    md := md ++ "## EGA and SGA items\n\n"
    for (work, title) in [(Stacks.EgaSga.Work.ega, "EGA"), (.sga, "SGA")] do
      let rows := (egaSga.filter (·.1.work == work)).qsort fun a b =>
        refLt a.1.ref b.1.ref || (a.1.ref == b.1.ref &&
          a.1.declName.toString < b.1.declName.toString)
      md := md ++ s!"### {title}\n\n"
      if rows.isEmpty then
        md := md ++ "None.\n\n"
        continue
      md := md ++ "| Item | Part | Declaration | Source | Module |\n|---|---|---|---|---|\n"
      for (r, m) in rows do
        let src := ", ".intercalate <| (sources.filter (·.1.declName == r.declName)).toList.map
          fun (e, _) => match e.work with
            | .montpellier => s!"Montpellier {e.ref}"
            | .buffalo => s!"Buffalo {e.ref}"
        md := md ++ s!"| {title} {r.ref} | {r.comment} | `{r.declName}` | {src} | `{m}` |\n"
      md := md ++ "\n"
    IO.FS.writeFile out md
    IO.println s!"{montpellier.size} Montpellier, {buffalo.size} Buffalo, {egaSga.size} \
      EGA/SGA references. Report: {out}"
    return 0
  | _ =>
    IO.eprintln "usage: lake env lean --run scripts/SourceIndex.lean <root module> <output> \
      <module prefix>..."
    return 2
