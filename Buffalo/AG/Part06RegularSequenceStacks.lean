import Buffalo.AG.Part06b
import StacksFrontier.RingTheory.RegularLocalRing.Basic
import StacksFrontier.RingTheory.RegularLocalRing.Criteria

/-!
# Buffalo, algebraic geometry, part 06: regular local rings and regular sequences

`Part06b.lean` states the entry `Oqhr-Gt66es-7860` (2:11:00: a noetherian local ring is regular if
its maximal ideal is generated by a regular sequence `x₁, …, xₙ`) as the definition
`IsRegularBySequence`, and leaves its agreement with Mathlib's `IsRegularLocalRing` (the maximal
ideal is generated by `dim A` elements) unformalised. It is proved here from AxiomMath/Stacks
(Apache-2.0).

**What is proved.** `thm_7860`: for a noetherian local ring `A`,
* `A` is regular (Mathlib's `IsRegularLocalRing`) if and only if its maximal ideal is generated by
  an `A`-regular sequence (`RingTheory.Sequence.IsRegular A xs ∧ Ideal.ofList xs = 𝔪`);
* the length of any regular sequence generating the maximal ideal is `dim A`.

`isRegularBySequence_iff`: the lecture's definition `IsRegularBySequence` agrees with Mathlib's
`IsRegularLocalRing`.

**How.** If `A` is regular, a list generating `𝔪` of the minimal length `μ(𝔪) = dim A` exists
(Stacks 00NR, applied to `I = 𝔪`:
`IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq`),
and such a list is a regular sequence (Stacks 00NQ:
`IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`,
`StacksFrontier/RingTheory/RegularLocalRing/Basic.lean`). Conversely, if `𝔪` is generated by a
regular sequence, `A/𝔪` is a field, hence regular, and `A` is regular by Stacks 00NU
(`isRegularLocalRing_of_isRegular`, `StacksFrontier/RingTheory/RegularLocalRing/Criteria.lean`).
The length is Mathlib's `ringKrullDim_add_length_eq_ringKrullDim_of_isRegular`:
`dim (A/(x₁, …, xₙ)) + n = dim A`, with `dim (A/𝔪) = 0`.

**Not formalised.** Nothing of the entry. The further facts of Stacks 00NQ (each
`A/(x₁, …, x_c)` regular of dimension `d - c`, `A` Cohen–Macaulay) are not part of it and are not restated here.
-/

open IsLocalRing

universe u

namespace Buffalo.AG.Part06

/-- Oqhr-Gt66es-7860 (2:11:00) [def] A noetherian local ring `A` is regular if and only if its
maximal ideal is generated by an `A`-regular sequence `x₁, …, xₙ`; then `n = dim A`.
Stacks 00NQ, 00NR and 00NU. -/
theorem thm_7860 {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] :
    (IsRegularLocalRing A ↔ ∃ xs : List A, RingTheory.Sequence.IsRegular A xs ∧
      Ideal.ofList xs = maximalIdeal A) ∧
    (∀ xs : List A, RingTheory.Sequence.IsRegular A xs → Ideal.ofList xs = maximalIdeal A →
      (xs.length : WithBot ℕ∞) = ringKrullDim A) := by
  -- `A/𝔪` is a field, hence a regular local ring.
  have hK : IsRegularLocalRing (A ⧸ maximalIdeal A) := by
    let := Ideal.Quotient.field (maximalIdeal A)
    infer_instance
  refine ⟨⟨fun hR => ?_, fun ⟨xs, hreg, hgen⟩ => ?_⟩, fun xs hreg hgen => ?_⟩
  · obtain ⟨xs, hgen, hlen, -⟩ :=
      IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq
        (maximalIdeal A) hK
    have h00NQ :=
      IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay A
    exact ⟨xs, (h00NQ.1 xs hgen hlen).1, hgen⟩
  · refine isRegularLocalRing_of_isRegular A xs hreg ?_
    rw [hgen]
    exact hK
  · have h := ringKrullDim_add_length_eq_ringKrullDim_of_isRegular xs hreg
    have h0 : ringKrullDim (A ⧸ maximalIdeal A) = 0 :=
      ringKrullDim_eq_zero_of_isField
        ((Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp (maximalIdeal.isMaximal A))
    rw [hgen, h0, zero_add] at h
    exact h

/-- Oqhr-Gt66es-7860: the lecture's definition `IsRegularBySequence` (noetherian, maximal ideal
generated by a regular sequence) agrees with Mathlib's `IsRegularLocalRing`. -/
theorem isRegularBySequence_iff (A : Type u) [CommRing A] [IsLocalRing A] :
    IsRegularBySequence A ↔ IsRegularLocalRing A := by
  constructor
  · rintro ⟨hN, h⟩
    exact (@thm_7860 A _ _ hN).1.mpr h
  · intro hR
    exact ⟨inferInstance, (thm_7860 (A := A)).1.mp hR⟩

end Buffalo.AG.Part06
