module

public import Grothendieck.Folder126NilpotentDescent
import Grothendieck.Attr

@[expose] public section

/-!
# Folder 126, pages 5 to 7: flatness of `X → Y` for a nilpotent `𝒥_X`

Finding `126-nilpotent-deformation-quotient`, continued from `Folder126NilpotentDescent`, which
proves, in the affine situation `IsThickenedNerve`, the exact sequence
`0 → 𝒥_Y → 𝒪_Y → 𝒪_{Y₀} → 0` for a nilpotent `𝒥_X` but the flatness of `X → Y` only for
`𝒥_X² = 0`. Pages 5 to 7 reduce the nilpotent case to the square-zero one; this file carries out
that reduction in the affine case, as an induction along the infinitesimal neighbourhoods
`X₀ = X_1 ⊂ X_2 ⊂ ⋯ ⊂ X_N = X`, `X_k = Spec (B' ⧸ J^k)`, over `Y_k = Spec (A' ⧸ (J^k ∩ A'))`,
`A' = Ker(B' ⇉ C')`.

**What is proved.**
* `Grothendieck.Folder126NilpotentFlat.exists_isBaseChange_of_comparison`: a `B`-module with
  Čech comparison maps along a flat `A → B` (the data of
  `Module.Descent.exists_sub_eq_of_cocycle`) is the base change of its invariant elements
  (Stacks 023N).
* `IsThickenedNerve.exists_isBaseChange_grPiece`: descent of every graded piece
  `J^m ⧸ J^(m+1)` of `𝒥_X` to its invariant classes.
* `IsThickenedNerve.exists_mem_eqLocus_sub_mem` and `exists_mem_eqLocus_grPiece_eq`: an element
  invariant modulo `J^m C'` is congruent modulo `J^m` to an invariant function (the lift
  corrected one graded piece at a time); so every invariant class of `J^m ⧸ J^(m+1)` is the
  class of an invariant function.
* `IsThickenedNerve.ker_eq_map_comap`: `𝒥_X = 𝒥_Y 𝒪_X`, the ideal `J` is generated by the
  invariant functions it contains.
* `IsThickenedNerve.flat_levelMap_one`, `flat_levelMap_succ`: `B' ⧸ J^k` is flat over
  `A' ⧸ (J^k ∩ A')` (`levelMap`), for `k = 1` and then by induction on `k`.
* `IsThickenedNerve.flat_eqLocus_of_isNilpotent`: **`X → Y` is flat**, `B'` flat over `A'`, for
  a nilpotent `J`; `flat_and_bijective_of_isNilpotent` adds the bijectivity of a map
  `B' ⊗_{A'} B' → C''` bijective modulo `𝒥_Y` (`R ≅ X ×_Y X`), and `isNilpotent_ker_toBase`
  that `𝒥_Y` is nilpotent.

**How.** The induction step is the square-zero criterion
`Ideal.bijective_fibreTensorSMulHomToKer_iff` (Stacks 063Y, affine case) for the square-zero
thickening `X_k ⊂ X_(k+1)` over `Y_k ⊂ Y_(k+1)`, `k ≥ 1`: `B' ⧸ J^k` is flat over
`(A' ⧸ (J^(k+1) ∩ A')) ⧸ I ≅ A' ⧸ (J^k ∩ A')` by induction, and the canonical map
`I ⊗ (B' ⧸ J^k) → J^k ⧸ J^(k+1)`, `I = (J^k ∩ A') ⧸ (J^(k+1) ∩ A')`, is bijective because it
factors the descent isomorphism `B ⊗_A M_k ≅ J^k ⧸ J^(k+1)` of the graded piece through a
surjection `B ⊗_A M_k → I ⊗ (B' ⧸ J^k)`, where `M_k ≅ I` is the module of invariant classes. That
surjection is well defined because `J = (J ∩ A') B'` and `(J ∩ A') I = 0`. The graded descent
and the climb follow the proofs of `Module.Descent.exists_grMap_sub_grMap_eq` and
`Module.Descent.exists_eq_of_isNilpotent_ker`, and the comparison lemma that of
`Module.Descent.exists_sub_eq_of_cocycle` (vendored Stacks files), with effectivity of descent,
`Module.Descent.Datum.isBaseChange`, in place of the vanishing of `Ȟ¹`.

**Not formalised.**
* The scheme level, as listed in `Folder126NilpotentDescent`: a non-affine `Y₀`, the vanishing
  `Ȟ⁰(X₀/Y₀, ℋ¹(𝒥_Y)) = 0` of Remark 2, the gluing of `Y`, the effectivity of `R`.
* The nerve itself: `R ×_X R` and `R₀ ≅ X₀ ×_{Y₀} X₀` are the hypotheses of `IsThickenedNerve`.
* In `flat_and_bijective_of_isNilpotent` the map `φ` and its bijectivity modulo `𝒥_Y` are
  hypotheses (identifying `(A' ⧸ 𝒥_Y) ⊗ φ` with `R₀ ≅ X₀ ×_{Y₀} X₀` is not done).
-/

namespace Grothendieck.Folder126NilpotentFlat

open TensorProduct Module.Descent

section Comparison

variable {A B C D : Type*} [CommRing A] [CommRing B] [CommRing C] [CommRing D] [Algebra A B]
  {K L P : Type*} [AddCommGroup K] [Module A K] [Module B K] [IsScalarTower A B K]
  [AddCommGroup L] [Module C L] [AddCommGroup P] [Module D P]

/-- **Descent from comparison maps** (Stacks 023N). In the situation of
`Module.Descent.exists_sub_eq_of_cocycle`, with `A → B` flat, the `B`-module `K` is the base
change of its `A`-submodule of invariant elements, those `k` with `α₁ k = α₂ k`. The descent
datum is the one built in the proof of `Module.Descent.exists_sub_eq_of_cocycle`, which this
follows; the conclusion is effectivity of descent instead of the vanishing of `Ȟ¹`. -/
theorem exists_isBaseChange_of_comparison [Module.Flat A B]
    (i₁ i₂ : B →+* C) (μ : C →+* B) (f₁₂ f₁₃ f₂₃ : C →+* D)
    (hA : ∀ a : A, i₁ (algebraMap A B a) = i₂ (algebraMap A B a))
    (hμ : ∀ b, μ (i₁ b) = b)
    (h₁₂₁₃ : ∀ b, f₁₂ (i₁ b) = f₁₃ (i₁ b)) (h₁₂₂₃ : ∀ b, f₁₂ (i₂ b) = f₂₃ (i₁ b))
    (α₁ α₂ : K →+ L) (hα₁ : ∀ (b : B) (k : K), α₁ (b • k) = i₁ b • α₁ k)
    (hα₂ : ∀ (b : B) (k : K), α₂ (b • k) = i₂ b • α₂ k)
    (Δ : L →+ K) (hΔ : ∀ (c : C) (l : L), Δ (c • l) = μ c • Δ l)
    (hΔ₁ : ∀ k, Δ (α₁ k) = k) (hΔ₂ : ∀ k, Δ (α₂ k) = k)
    (γ₁₂ γ₁₃ γ₂₃ : L →+ P) (hγ₁₂ : ∀ (c : C) (l : L), γ₁₂ (c • l) = f₁₂ c • γ₁₂ l)
    (hγ₁₃ : ∀ (c : C) (l : L), γ₁₃ (c • l) = f₁₃ c • γ₁₃ l)
    (hγ₂₃ : ∀ (c : C) (l : L), γ₂₃ (c • l) = f₂₃ c • γ₂₃ l)
    (hγα₁ : ∀ k, γ₁₂ (α₁ k) = γ₁₃ (α₁ k)) (hγα₂ : ∀ k, γ₁₂ (α₂ k) = γ₂₃ (α₁ k))
    (hγα₃ : ∀ k, γ₁₃ (α₂ k) = γ₂₃ (α₂ k))
    (hL : Function.Bijective (cmpLeft i₁ i₂ hA α₂ hα₂))
    (hP : Function.Injective (cmpRight i₁ i₂ hA α₂ hα₂ f₁₂ f₂₃ h₁₂₂₃ γ₂₃ hγ₂₃)) :
    ∃ M : Submodule A K, (∀ k, k ∈ M ↔ α₁ k = α₂ k) ∧ IsBaseChange B M.subtype := by
  classical
  set θ := cmpLeft i₁ i₂ hA α₂ hα₂
  set ρ := cmpRight i₁ i₂ hA α₂ hα₂ f₁₂ f₂₃ h₁₂₂₃ γ₂₃ hγ₂₃
  let eθ : B ⊗[A] K ≃ L := Equiv.ofBijective θ hL
  have heθ : ∀ l, θ (eθ.symm l) = l := fun l => Equiv.ofBijective_apply_symm_apply θ hL l
  let co : K →ₗ[B] B ⊗[A] K :=
    { toFun := fun k => eθ.symm (α₁ k)
      map_add' := fun k k' => hL.1 (by simp only [map_add, heθ])
      map_smul' := fun b k => hL.1 (by
        rw [RingHom.id_apply, heθ, cmpLeft_smul, heθ, hα₁]) }
  have hco : ∀ k, θ (co k) = α₁ k := fun k => heθ (α₁ k)
  have hcounit : ∀ x : B ⊗[A] K, counit A B K x = Δ (θ x) := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul b k => rw [counit_tmul, cmpLeft_tmul, hΔ, hμ, hΔ₂]
    | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]
  have hρco : ∀ x : B ⊗[A] K,
      ρ (AlgebraTensorModule.lTensor B B (co.restrictScalars A) x) = γ₁₂ (θ x) := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul b k =>
      rw [AlgebraTensorModule.lTensor_tmul, LinearMap.restrictScalars_apply, cmpRight_tmul, hco,
        cmpLeft_tmul, hγ₁₂, hγα₂]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  have hρmk : ∀ x : B ⊗[A] K,
      ρ (AlgebraTensorModule.lTensor B B (TensorProduct.mk A B K 1) x) = γ₁₃ (θ x) := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul b k =>
      rw [AlgebraTensorModule.lTensor_tmul, TensorProduct.mk_apply, cmpRight_tmul, cmpLeft_tmul,
        map_one, one_smul, cmpLeft_tmul, hγ₁₃, h₁₂₁₃, hγα₃]
    | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  let d : Datum A B K :=
    { coaction := co
      counit_coaction := fun k => by rw [hcounit, hco, hΔ₁]
      coassoc := fun k => hP (by rw [hρco, hρmk, hco, hγα₁]) }
  refine ⟨d.descended, fun k => ?_, d.isBaseChange⟩
  rw [Datum.mem_descended_iff]
  change co k = (1 : B) ⊗ₜ k ↔ _
  constructor
  · intro h
    have h' := congrArg θ h
    rwa [hco, cmpLeft_tmul, map_one, one_smul] at h'
  · intro h
    apply hL.1
    rw [hco, cmpLeft_tmul, map_one, one_smul, h]

end Comparison

end Grothendieck.Folder126NilpotentFlat

namespace Grothendieck.Folder126NilpotentDescent

open TensorProduct Module.Descent Grothendieck.Folder126NilpotentFlat

universe u

section Nerve

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
  {B' C' D' : Type u} [CommRing B'] [CommRing C'] [CommRing D']
  {πB : B' →+* B} {πC : C' →+* B ⊗[A] B} {πD : D' →+* B ⊗[A] (B ⊗[A] B)}
  {s t : B' →+* C'} {μ : C' →+* B'} {f₁₂ f₁₃ f₂₃ : C' →+* D'}

/-- The `n`-th truncation of the invariant ring: `A' ⧸ (J^n ∩ A')`, for `A' = Ker(B' ⇉ C')`. -/
abbrev LevelBase (πB : B' →+* B) (s t : B' →+* C') (n : ℕ) : Type u :=
  RingHom.eqLocus s t ⧸ (RingHom.ker πB ^ n).comap (RingHom.eqLocus s t).subtype

/-- The `n`-th truncation of `B'`: the ring `B' ⧸ J^n` of the `n`-th infinitesimal neighbourhood
`X_n` of `X₀` in `X`. -/
abbrev LevelTop (πB : B' →+* B) (n : ℕ) : Type u := B' ⧸ RingHom.ker πB ^ n

/-- The map `𝒪(Y_n) → 𝒪(X_n)` of the `n`-th truncations. -/
noncomputable def levelMap (πB : B' →+* B) (s t : B' →+* C') (n : ℕ) :
    LevelBase πB s t n →+* LevelTop πB n :=
  Ideal.quotientMap _ (RingHom.eqLocus s t).subtype le_rfl

/-- `levelMap` on the class of an invariant function. -/
theorem levelMap_mk (n : ℕ) (a : RingHom.eqLocus s t) :
    levelMap πB s t n (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (a : B') := rfl

namespace IsThickenedNerve

variable (H : IsThickenedNerve πB πC πD s t μ f₁₂ f₁₃ f₂₃)
include H

/-- `s` carries `J` into `J C'`. -/
theorem hs : ∀ x ∈ RingHom.ker πB, s x ∈ RingHom.ker πC :=
  map_mem_ker_of_map_eq s H.ker_C_s

/-- `t` carries `J` into `J C'`. -/
theorem ht : ∀ x ∈ RingHom.ker πB, t x ∈ RingHom.ker πC :=
  map_mem_ker_of_map_eq t H.ker_C_t

/-- `f₂₃` carries `J C'` into `J D'`. -/
theorem h23 : ∀ x ∈ RingHom.ker πC, f₂₃ x ∈ RingHom.ker πD :=
  map_mem_ker_of_map_eq f₂₃ H.ker_D

/-- `f₁₂` carries `J C'` into `J D'`. -/
theorem h12 : ∀ x ∈ RingHom.ker πC, f₁₂ x ∈ RingHom.ker πD := by
  refine map_mem_ker_of_map_eq f₁₂ ?_
  symm
  rw [H.ker_C_t, Ideal.map_map, H.f₁₂_t, ← Ideal.map_map, ← H.ker_C_s, H.ker_D]

/-- `f₁₃` carries `J C'` into `J D'`. -/
theorem h13 : ∀ x ∈ RingHom.ker πC, f₁₃ x ∈ RingHom.ker πD := by
  refine map_mem_ker_of_map_eq f₁₃ ?_
  symm
  rw [H.ker_C_t, Ideal.map_map, H.f₁₃_t, ← Ideal.map_map, ← H.ker_C_t, H.ker_D]

omit H in
/-- `B ⊗_A B` is the pushout of `A → B` along itself. -/
theorem pushout₁ : CategoryTheory.IsPushout (CommRingCat.ofHom (algebraMap A B))
    (CommRingCat.ofHom (algebraMap A B))
    (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] B))
    (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B).toRingHom) :=
  CommRingCat.isPushout_tensorProduct A B B

omit H in
/-- `B ⊗_A (B ⊗_A B)` is the pushout of `A → B` and `A → B ⊗_A B`, in the form
`Module.Descent.exists_grMap_sub_grMap_eq` uses. -/
theorem pushout₂ : CategoryTheory.IsPushout (CommRingCat.ofHom (algebraMap A B))
    (CommRingCat.ofHom
      ((Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] B).comp (algebraMap A B)))
    (CommRingCat.ofHom ((Algebra.TensorProduct.map (AlgHom.id A B)
      (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B)).toRingHom.comp
        (Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] B)))
    (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
      B ⊗[A] B →ₐ[A] B ⊗[A] (B ⊗[A] B)).toRingHom) := by
  have e1 : (Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] B).comp (algebraMap A B) =
      algebraMap A (B ⊗[A] B) := RingHom.ext fun a => rfl
  have e2 : (Algebra.TensorProduct.map (AlgHom.id A B)
      (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B)).toRingHom.comp
        (Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] B) =
      (Algebra.TensorProduct.includeLeftRingHom : B →+* B ⊗[A] (B ⊗[A] B)) := by
    refine RingHom.ext fun b => ?_
    simp
  rw [e1, e2]
  exact CommRingCat.isPushout_tensorProduct A B (B ⊗[A] B)

/-- The Čech cocycle identity for the coboundary of an element of `B'`. -/
theorem cocycle (b : B') : f₁₂ (s b - t b) - f₁₃ (s b - t b) + f₂₃ (s b - t b) = 0 := by
  have e1 := RingHom.congr_fun H.f₁₂_s b
  have e2 := RingHom.congr_fun H.f₁₂_t b
  have e3 := RingHom.congr_fun H.f₁₃_t b
  simp only [RingHom.comp_apply] at e1 e2 e3
  simp only [map_sub, e1, e2, e3]
  ring

/-- **Climbing an invariant class** (pages 5 to 7, the lift corrected one graded piece at a
time). If `J` is nilpotent and `b ∈ B'` is invariant modulo `J^m C'`, there is an invariant
`b'` with `b' ≡ b` modulo `J^m`. For `m = 1` and `πB b ∈ A` this is
`Module.Descent.exists_eq_of_isNilpotent_ker`, whose proof this follows. -/
theorem exists_mem_eqLocus_sub_mem [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB)) {b : B'} {m : ℕ}
    (hb : s b - t b ∈ RingHom.ker πC ^ m) :
    ∃ b' ∈ RingHom.eqLocus s t, b' - b ∈ RingHom.ker πB ^ m := by
  classical
  have key : ∀ n : ℕ, ∃ b' : B', s b' - t b' ∈ RingHom.ker πC ^ (m + n) ∧
      b' - b ∈ RingHom.ker πB ^ m := by
    intro n
    induction n with
    | zero => exact ⟨b, by simpa using hb, by rw [sub_self]; exact Submodule.zero_mem _⟩
    | succ n ih =>
      obtain ⟨b', hδ, hb'⟩ := ih
      let ξ : grPiece πC (m + n) := Submodule.Quotient.mk ⟨s b' - t b', hδ⟩
      have hξ : grMap f₁₂ H.h12 (m + n) ξ - grMap f₁₃ H.h13 (m + n) ξ +
          grMap f₂₃ H.h23 (m + n) ξ = 0 := by
        simp only [ξ, grMap_mk, ← Submodule.Quotient.mk_sub, ← Submodule.Quotient.mk_add]
        rw [← Submodule.Quotient.mk_zero]
        congr 1
        exact Subtype.ext (H.cocycle b')
      obtain ⟨x, hx⟩ := exists_grMap_sub_grMap_eq s t μ f₁₂ f₁₃ f₂₃ H.surjective_B
        H.surjective_C H.surjective_D _ _ _ _ H.comp_s H.comp_t H.comp_f₁₂ H.comp_f₂₃ H.μ_s
        H.μ_t H.f₁₂_s H.f₁₂_t H.f₁₃_t H.ker_C_s H.ker_C_t H.ker_D H.flat_t H.flat_f₂₃ pushout₁
        pushout₂ (m + n) H.hs H.ht H.h12 H.h13 H.h23 ξ hξ
      obtain ⟨j, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      refine ⟨b' - j, ?_, ?_⟩
      · simp only [ξ, grMap_mk, ← Submodule.Quotient.mk_sub] at hx
        have h0 : (Submodule.Quotient.mk
            (⟨s j, mem_ker_pow_map s H.hs (m + n) j.2⟩ -
              ⟨t j, mem_ker_pow_map t H.ht (m + n) j.2⟩ -
              ⟨s b' - t b', hδ⟩) : grPiece πC (m + n)) = 0 := by
          rw [Submodule.Quotient.mk_sub, hx, sub_self]
        rw [grPiece_mk_eq_zero_iff] at h0
        have h1 : s (b' - j) - t (b' - j) = -((s j - t j) - (s b' - t b')) := by
          rw [map_sub, map_sub]
          ring
        rw [h1, ← add_assoc]
        refine (Ideal.neg_mem_iff _).2 ?_
        simpa using h0
      · have hj : (j : B') ∈ RingHom.ker πB ^ m :=
          Ideal.pow_le_pow_right (Nat.le_add_right m n) j.2
        have : b' - (j : B') - b = (b' - b) - j := by ring
        rw [this]
        exact Ideal.sub_mem _ hb' hj
  obtain ⟨N, hN⟩ := hnil
  obtain ⟨b', hb'N, hb'⟩ := key N
  refine ⟨b', ?_, hb'⟩
  have hKN : RingHom.ker πC ^ N = ⊥ := by
    rw [H.ker_C_t, ← Ideal.map_pow, hN, Submodule.zero_eq_bot, Ideal.map_bot]
  have : s b' - t b' ∈ RingHom.ker πC ^ N := Ideal.pow_le_pow_right (Nat.le_add_left N m) hb'N
  rwa [hKN, Ideal.mem_bot, sub_eq_zero] at this

/-- **Descent of the graded pieces of `𝒥_X`** (Stacks 023N): the `m`-th graded piece
`J^m ⧸ J^(m+1)`, a `B`-module, is the base change along `A → B` of its `A`-submodule of
invariant classes. The comparison maps are those of the proof of
`Module.Descent.exists_grMap_sub_grMap_eq`, which this follows. -/
theorem exists_isBaseChange_grPiece [Module.FaithfullyFlat A B] (m : ℕ) :
    letI : Module B (grPiece πB m) := grPiece.module H.surjective_B m
    letI : Module A (grPiece πB m) := Module.compHom _ (algebraMap A B)
    haveI : IsScalarTower A B (grPiece πB m) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    ∃ M : Submodule A (grPiece πB m),
      (∀ x, x ∈ M ↔ grMap s H.hs m x = grMap t H.ht m x) ∧ IsBaseChange B M.subtype := by
  classical
  let i₁ : B →+* B ⊗[A] B := Algebra.TensorProduct.includeLeftRingHom
  let i₂ : B →+* B ⊗[A] B := (Algebra.TensorProduct.includeRight : B →ₐ[A] B ⊗[A] B).toRingHom
  let g₁₂ : B ⊗[A] B →+* B ⊗[A] (B ⊗[A] B) := (Algebra.TensorProduct.map (AlgHom.id A B)
    (Algebra.TensorProduct.includeLeft : B →ₐ[A] B ⊗[A] B)).toRingHom
  let g₂₃ : B ⊗[A] B →+* B ⊗[A] (B ⊗[A] B) :=
    (Algebra.TensorProduct.includeRight : B ⊗[A] B →ₐ[A] B ⊗[A] (B ⊗[A] B)).toRingHom
  have hπB := H.surjective_B
  have hπC := H.surjective_C
  have hπD := H.surjective_D
  have hi₁ : πC.comp s = i₁.comp πB := H.comp_s
  have hi₂ : πC.comp t = i₂.comp πB := H.comp_t
  have hg₁₂ : πD.comp f₁₂ = g₁₂.comp πC := H.comp_f₁₂
  have hg₂₃ : πD.comp f₂₃ = g₂₃.comp πC := H.comp_f₂₃
  have hs := H.hs
  have ht := H.ht
  have h12 := H.h12
  have h13 := H.h13
  have h23 := H.h23
  have P1 := pushout₁ (A := A) (B := B)
  have P2 := pushout₂ (A := A) (B := B)
  have hμ : ∀ x ∈ RingHom.ker πC, μ x ∈ RingHom.ker πB :=
    map_mem_ker_of_map_eq μ (by rw [H.ker_C_t, Ideal.map_map, H.μ_t, Ideal.map_id])
  let μ₀ : B ⊗[A] B →+* B := descendHom hπC (πB.comp μ) (fun x hx => by
    simpa [RingHom.mem_ker] using hμ x hx)
  have hμ₀ : μ₀.comp πC = πB.comp μ := descendHom_comp _ _ _
  let g₁₃ : B ⊗[A] B →+* B ⊗[A] (B ⊗[A] B) := descendHom hπC (πD.comp f₁₃) (fun x hx => by
    simpa [RingHom.mem_ker] using h13 x hx)
  have hg₁₃ : g₁₃.comp πC = πD.comp f₁₃ := descendHom_comp _ _ _
  let mB : Module B (grPiece πB m) := grPiece.module hπB m
  let mC : Module (B ⊗[A] B) (grPiece πC m) := grPiece.module hπC m
  let mD : Module (B ⊗[A] (B ⊗[A] B)) (grPiece πD m) := grPiece.module hπD m
  let mA : Module A (grPiece πB m) := Module.compHom _ (algebraMap A B)
  have : IsScalarTower A B (grPiece πB m) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hRB : ∀ (r : B') (x : grPiece πB m), πB r • x = r • x := grPiece.module_smul hπB m
  have hRC : ∀ (r : C') (x : grPiece πC m), πC r • x = r • x := grPiece.module_smul hπC m
  have hRD : ∀ (r : D') (x : grPiece πD m), πD r • x = r • x := grPiece.module_smul hπD m
  have hA : ∀ a : A, i₁ (algebraMap A B a) = i₂ (algebraMap A B a) :=
    comp_apply_of_isPushout P1
  have hμ₁ : ∀ b, μ₀ (i₁ b) = b := by
    intro b
    obtain ⟨b', rfl⟩ := hπB b
    rw [← RingHom.comp_apply i₁ πB, ← hi₁, RingHom.comp_apply, ← RingHom.comp_apply μ₀ πC,
      hμ₀, RingHom.comp_apply, ← RingHom.comp_apply μ s, H.μ_s, RingHom.id_apply]
  have hr₁₂₁₃ : ∀ b, g₁₂ (i₁ b) = g₁₃ (i₁ b) := by
    intro b
    obtain ⟨b', rfl⟩ := hπB b
    rw [← RingHom.comp_apply i₁ πB, ← hi₁, RingHom.comp_apply, ← RingHom.comp_apply g₁₂ πC,
      ← hg₁₂, ← RingHom.comp_apply g₁₃ πC, hg₁₃, RingHom.comp_apply, RingHom.comp_apply,
      ← RingHom.comp_apply f₁₂ s, H.f₁₂_s, RingHom.comp_apply]
  have hr₁₂₂₃ : ∀ b, g₁₂ (i₂ b) = g₂₃ (i₁ b) := by
    intro b
    obtain ⟨b', rfl⟩ := hπB b
    rw [← RingHom.comp_apply i₂ πB, ← hi₂, ← RingHom.comp_apply i₁ πB, ← hi₁,
      RingHom.comp_apply, RingHom.comp_apply, ← RingHom.comp_apply g₁₂ πC, ← hg₁₂,
      ← RingHom.comp_apply g₂₃ πC, ← hg₂₃, RingHom.comp_apply, RingHom.comp_apply,
      ← RingHom.comp_apply f₁₂ t, H.f₁₂_t, RingHom.comp_apply]
  let α₁ := (grMap s hs m).toAddMonoidHom
  let α₂ := (grMap t ht m).toAddMonoidHom
  let Δ := (grMap μ hμ m).toAddMonoidHom
  let γ₁₂ := (grMap f₁₂ h12 m).toAddMonoidHom
  let γ₁₃ := (grMap f₁₃ h13 m).toAddMonoidHom
  let γ₂₃ := (grMap f₂₃ h23 m).toAddMonoidHom
  have hα₁ : ∀ (b : B) (k : grPiece πB m), α₁ (b • k) = i₁ b • α₁ k :=
    grMap_smul m hπB hRB hRC s i₁ hi₁ hs
  have hα₂ : ∀ (b : B) (k : grPiece πB m), α₂ (b • k) = i₂ b • α₂ k :=
    grMap_smul m hπB hRB hRC t i₂ hi₂ ht
  have hΔ : ∀ (c : B ⊗[A] B) (l : grPiece πC m), Δ (c • l) = μ₀ c • Δ l :=
    grMap_smul m hπC hRC hRB μ μ₀ hμ₀.symm hμ
  have hγ₁₂ : ∀ (c : B ⊗[A] B) (l : grPiece πC m), γ₁₂ (c • l) = g₁₂ c • γ₁₂ l :=
    grMap_smul m hπC hRC hRD f₁₂ g₁₂ hg₁₂ h12
  have hγ₁₃ : ∀ (c : B ⊗[A] B) (l : grPiece πC m), γ₁₃ (c • l) = g₁₃ c • γ₁₃ l :=
    grMap_smul m hπC hRC hRD f₁₃ g₁₃ hg₁₃.symm h13
  have hγ₂₃ : ∀ (c : B ⊗[A] B) (l : grPiece πC m), γ₂₃ (c • l) = g₂₃ c • γ₂₃ l :=
    grMap_smul m hπC hRC hRD f₂₃ g₂₃ hg₂₃ h23
  have hcomp : ∀ {X Y Z : Type u} [CommRing X] [CommRing Y] [CommRing Z] {πX : X →+* B}
      {πY : Y →+* B ⊗[A] B} {πZ : Z →+* B ⊗[A] (B ⊗[A] B)} (u : X →+* Y) (u' : X →+* Y)
      (v : Y →+* Z) (v' : Y →+* Z)
      (hu : ∀ x ∈ RingHom.ker πX, u x ∈ RingHom.ker πY)
      (hu' : ∀ x ∈ RingHom.ker πX, u' x ∈ RingHom.ker πY)
      (hv : ∀ x ∈ RingHom.ker πY, v x ∈ RingHom.ker πZ)
      (hv' : ∀ x ∈ RingHom.ker πY, v' x ∈ RingHom.ker πZ)
      (huv : v.comp u = v'.comp u') (k : grPiece πX m),
      grMap v hv m (grMap u hu m k) = grMap v' hv' m (grMap u' hu' m k) := by
    intro X Y Z _ _ _ πX πY πZ u u' v v' hu hu' hv hv' huv k
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ k
    simp only [grMap_mk]
    congr 2
    exact congrArg (fun φ : X →+* Z => φ x) huv
  have hΔ₁ : ∀ k, Δ (α₁ k) = k := by
    intro k
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ k
    change grMap μ hμ m (grMap s hs m (Submodule.Quotient.mk x)) = Submodule.Quotient.mk x
    simp only [grMap_mk]
    congr 2
    exact congrArg (fun φ : B' →+* B' => φ x) H.μ_s
  have hΔ₂ : ∀ k, Δ (α₂ k) = k := by
    intro k
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ k
    change grMap μ hμ m (grMap t ht m (Submodule.Quotient.mk x)) = Submodule.Quotient.mk x
    simp only [grMap_mk]
    congr 2
    exact congrArg (fun φ : B' →+* B' => φ x) H.μ_t
  have hγα₁ : ∀ k, γ₁₂ (α₁ k) = γ₁₃ (α₁ k) := fun k =>
    hcomp s s f₁₂ f₁₃ hs hs h12 h13 H.f₁₂_s k
  have hγα₂ : ∀ k, γ₁₂ (α₂ k) = γ₂₃ (α₁ k) := fun k =>
    hcomp t s f₁₂ f₂₃ ht hs h12 h23 H.f₁₂_t k
  have hγα₃ : ∀ k, γ₁₃ (α₂ k) = γ₂₃ (α₂ k) := fun k =>
    hcomp t t f₁₃ f₂₃ ht ht h13 h23 H.f₁₃_t k
  have hLbij : Function.Bijective (cmpLeft i₁ i₂ hA α₂ hα₂) := by
    let : Algebra B (B ⊗[A] B) := i₂.toAlgebra
    have h0 := bijective_tensor_grMap m hπB hπC hRB hRC t H.flat_t hi₂ H.ker_C_t ht
    have h1 := bijective_pushoutTensorMap (A := A) (B₂ := B) i₁ hA P1 (grPiece πB m)
    convert h0.comp h1 using 1
    ext y
    induction y using TensorProduct.inductionOn with
    | tmul b k => rfl
    | add y z hy hz =>
      simp only [map_add, Function.comp_apply] at hy hz ⊢
      rw [hy, hz]
  have hPinj : Function.Injective
      (cmpRight i₁ i₂ hA α₂ hα₂ g₁₂ g₂₃ hr₁₂₂₃ γ₂₃ hγ₂₃) := by
    let : Algebra (B ⊗[A] B) (B ⊗[A] (B ⊗[A] B)) := g₂₃.toAlgebra
    let mAC : Module A (grPiece πC m) := Module.compHom _ (algebraMap A (B ⊗[A] B))
    have : IsScalarTower A (B ⊗[A] B) (grPiece πC m) :=
      IsScalarTower.of_algebraMap_smul fun _ _ => rfl
    let θ : B ⊗[A] grPiece πB m →ₗ[A] grPiece πC m :=
      { toFun := cmpLeft i₁ i₂ hA α₂ hα₂
        map_add' := map_add _
        map_smul' := fun a y => by
          rw [RingHom.id_apply, ← algebraMap_smul B a y, cmpLeft_smul]
          rfl }
    let eθ : B ⊗[A] grPiece πB m ≃ₗ[A] grPiece πC m := LinearEquiv.ofBijective θ hLbij
    have h0 := bijective_tensor_grMap m hπC hπD hRC hRD f₂₃ H.flat_f₂₃ hg₂₃ H.ker_D h23
    have h1 := bijective_pushoutTensorMap (A := A) (B₂ := B ⊗[A] B) (g₁₂.comp i₁)
      (comp_apply_of_isPushout P2) P2 (grPiece πC m)
    convert (h0.comp (h1.comp (eθ.lTensor B).bijective)).1 using 1
    ext y
    induction y using TensorProduct.inductionOn with
    | tmul b k => rfl
    | add y z hy hz =>
      simp only [map_add, Function.comp_apply] at hy hz ⊢
      rw [hy, hz]
  exact exists_isBaseChange_of_comparison i₁ i₂ μ₀ g₁₂ g₁₃ g₂₃ hA hμ₁ hr₁₂₁₃ hr₁₂₂₃ α₁ α₂ hα₁
    hα₂ Δ hΔ hΔ₁ hΔ₂ γ₁₂ γ₁₃ γ₂₃ hγ₁₂ hγ₁₃ hγ₂₃ hγα₁ hγα₂ hγα₃ hLbij hPinj

/-- An invariant class of `J^m ⧸ J^(m+1)` is the class of an invariant function. -/
theorem exists_mem_eqLocus_grPiece_eq [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB)) {m : ℕ} (x : ↥(RingHom.ker πB ^ m))
    (hx : grMap s H.hs m (Submodule.Quotient.mk x) = grMap t H.ht m (Submodule.Quotient.mk x)) :
    ∃ a ∈ RingHom.eqLocus s t, ∃ ha : a ∈ RingHom.ker πB ^ m,
      (Submodule.Quotient.mk ⟨a, ha⟩ : grPiece πB m) = Submodule.Quotient.mk x := by
  have h0 : (Submodule.Quotient.mk
      (⟨s x, mem_ker_pow_map s H.hs m x.2⟩ - ⟨t x, mem_ker_pow_map t H.ht m x.2⟩) :
        grPiece πC m) = 0 := by
    rw [Submodule.Quotient.mk_sub]
    simpa only [grMap_mk, sub_eq_zero] using hx
  rw [grPiece_mk_eq_zero_iff] at h0
  obtain ⟨a, ha, hax⟩ := H.exists_mem_eqLocus_sub_mem hnil (b := x) h0
  have ham : a ∈ RingHom.ker πB ^ m := by
    have : a = (a - x) + x := by ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.pow_le_pow_right (Nat.le_succ m) hax) x.2
  refine ⟨a, ha, ham, ?_⟩
  rw [← sub_eq_zero, ← Submodule.Quotient.mk_sub, grPiece_mk_eq_zero_iff]
  exact hax

/-- **`𝒥_X = 𝒥_Y 𝒪_X` modulo `J²`**: every element of `J` is, modulo `J²`, a combination of
invariant functions lying in `J`, by descent of `J ⧸ J²` and the climb. -/
theorem ker_le_map_comap_sup_pow_two [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB)) :
    RingHom.ker πB ≤ ((RingHom.ker πB).comap (RingHom.eqLocus s t).subtype).map
      (RingHom.eqLocus s t).subtype ⊔ RingHom.ker πB ^ 2 := by
  classical
  let mB : Module B (grPiece πB 1) := grPiece.module H.surjective_B 1
  let mA : Module A (grPiece πB 1) := Module.compHom _ (algebraMap A B)
  have : IsScalarTower A B (grPiece πB 1) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  obtain ⟨M, hM, hbc⟩ := H.exists_isBaseChange_grPiece 1
  let I₁ := ((RingHom.ker πB).comap (RingHom.eqLocus s t).subtype).map
      (RingHom.eqLocus s t).subtype
  have key : ∀ ξ : grPiece πB 1, ∃ y ∈ I₁, ∃ hy : y ∈ RingHom.ker πB ^ 1,
      (Submodule.Quotient.mk ⟨y, hy⟩ : grPiece πB 1) = ξ := by
    intro ξ
    obtain ⟨z, rfl⟩ := hbc.equiv.surjective ξ
    induction z using TensorProduct.inductionOn with
    | tmul b m =>
      rw [IsBaseChange.equiv_tmul]
      obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (m : grPiece πB 1)
      have hinv := (hM m).1 m.2
      rw [← hx] at hinv
      obtain ⟨a, ha, ham, haeq⟩ := H.exists_mem_eqLocus_grPiece_eq hnil x hinv
      obtain ⟨b', rfl⟩ := H.surjective_B b
      have haJ : a ∈ RingHom.ker πB := by simpa using ham
      refine ⟨b' * a, Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _
        (show (⟨a, ha⟩ : RingHom.eqLocus s t) ∈
          (RingHom.ker πB).comap (RingHom.eqLocus s t).subtype from haJ)),
        Ideal.mul_mem_left _ _ ham, ?_⟩
      change _ = πB b' • (m : grPiece πB 1)
      rw [← hx, ← haeq]
      exact (grPiece.module_smul H.surjective_B 1 b'
        (Submodule.Quotient.mk ⟨a, ham⟩ : grPiece πB 1)).symm
    | add z z' hz hz' =>
      obtain ⟨y, hyI, hy, hyz⟩ := hz
      obtain ⟨y', hyI', hy', hyz'⟩ := hz'
      refine ⟨y + y', Ideal.add_mem _ hyI hyI', Ideal.add_mem _ hy hy', ?_⟩
      rw [map_add, ← hyz, ← hyz', ← Submodule.Quotient.mk_add]
      rfl
  intro x hx
  obtain ⟨y, hyI, hy, hyx⟩ := key (Submodule.Quotient.mk ⟨x, by simpa using hx⟩)
  rw [← sub_eq_zero, ← Submodule.Quotient.mk_sub, grPiece_mk_eq_zero_iff] at hyx
  have : x = y - (y - x) := by ring
  rw [this]
  exact Ideal.sub_mem _ (Ideal.mem_sup_left hyI) (Ideal.mem_sup_right (by simpa using hyx))

/-- **`𝒥_X = 𝒥_Y 𝒪_X`** for a nilpotent `J`: `J` is generated by the invariant functions it
contains. -/
@[montpellier "126, 5–7"]
theorem ker_eq_map_comap [Module.FaithfullyFlat A B] (hnil : IsNilpotent (RingHom.ker πB)) :
    RingHom.ker πB = ((RingHom.ker πB).comap (RingHom.eqLocus s t).subtype).map
      (RingHom.eqLocus s t).subtype := by
  set J := RingHom.ker πB
  set I₁ := (J.comap (RingHom.eqLocus s t).subtype).map (RingHom.eqLocus s t).subtype
  have h2 := H.ker_le_map_comap_sup_pow_two hnil
  have hI : I₁ ≤ J := Ideal.map_comap_le
  have step : ∀ n : ℕ, J ≤ I₁ ⊔ J ^ (n + 1) := by
    intro n
    induction n with
    | zero => rw [zero_add, pow_one]; exact le_sup_right
    | succ n ih =>
      calc J ≤ I₁ ⊔ J ^ 2 := h2
        _ = I₁ ⊔ J * J := by rw [pow_two]
        _ ≤ I₁ ⊔ J * (I₁ ⊔ J ^ (n + 1)) := sup_le_sup_left (Ideal.mul_mono_right ih) _
        _ = I₁ ⊔ (J * I₁ ⊔ J * J ^ (n + 1)) := by rw [Ideal.mul_sup]
        _ ≤ I₁ ⊔ J ^ (n + 1 + 1) := by
          refine sup_le le_sup_left (sup_le (le_sup_of_le_left
            (Ideal.mul_le.2 fun r _ x hx => Ideal.mul_mem_left _ r hx)) ?_)
          rw [← pow_succ']
          exact le_sup_right
  obtain ⟨N, hN⟩ := hnil
  refine le_antisymm ?_ hI
  have hN' : J ^ (N + 1) = ⊥ := by rw [pow_succ, hN, zero_mul, Submodule.zero_eq_bot]
  simpa [hN'] using step N

/-- **The first truncation**: `B'/J = B` is flat over `A'/(J ∩ A') = A`. -/
theorem flat_levelMap_one [Module.FaithfullyFlat A B] (hnil : IsNilpotent (RingHom.ker πB)) :
    (levelMap πB s t 1).Flat := by
  have hA : (RingHom.ker πB ^ 1).comap (RingHom.eqLocus s t).subtype = RingHom.ker H.toBase := by
    rw [pow_one, (H.ker_toBase_eq_and_surjective hnil).1]
  let eA : LevelBase πB s t 1 ≃+* A := (Ideal.quotEquivOfEq hA).trans
    (RingHom.quotientKerEquivOfSurjective (H.surjective_toBase hnil))
  let eB : LevelTop πB 1 ≃+* B := (Ideal.quotEquivOfEq (pow_one (RingHom.ker πB))).trans
    (RingHom.quotientKerEquivOfSurjective H.surjective_B)
  have hcomm : eB.toRingHom.comp (levelMap πB s t 1) = (algebraMap A B).comp eA.toRingHom := by
    refine Ideal.Quotient.ringHom_ext (RingHom.ext fun a => ?_)
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      levelMap_mk]
    change πB (a : B') = algebraMap A B (H.toBase a)
    rw [H.algebraMap_toBase]
  rw [← RingHom.Flat.comp_iff_of_bijective_left (g := eB.toRingHom) eB.bijective, hcomm,
    RingHom.Flat.comp_iff_of_bijective_right (g := eA.toRingHom) eA.bijective]
  exact RingHom.flat_algebraMap_iff.mpr inferInstance

set_option maxHeartbeats 2000000 in
/-- **The induction step** (pages 5 to 7, the reduction of a nilpotent `𝒥_X` to `𝒥_X² = 0`):
if `B'/J^k` is flat over `A'/(J^k ∩ A')`, so is `B'/J^(k+1)` over `A'/(J^(k+1) ∩ A')`. This is
the square-zero criterion `Ideal.bijective_fibreTensorSMulHomToKer_iff` (Stacks 063Y) for the
square-zero thickening `X_k ⊂ X_(k+1)`, whose conormal module `J^k ⧸ J^(k+1)` descends to the
invariant classes, the classes of the invariant functions in `J^k`
(`exists_isBaseChange_grPiece`, `exists_mem_eqLocus_grPiece_eq`). -/
theorem flat_levelMap_succ [Module.FaithfullyFlat A B] (hnil : IsNilpotent (RingHom.ker πB))
    {k : ℕ} (hk : 1 ≤ k) (hflat : (levelMap πB s t k).Flat) :
    (levelMap πB s t (k + 1)).Flat := by
  classical
  set J := RingHom.ker πB with hJ
  have hle : J ^ (k + 1) ≤ J ^ k := Ideal.pow_le_pow_right (Nat.le_succ k)
  have hle' : (J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype ≤
      (J ^ k).comap (RingHom.eqLocus s t).subtype := Ideal.comap_mono hle
  have h2k : J ^ k * J ^ k ≤ J ^ (k + 1) := by
    rw [← pow_add]; exact Ideal.pow_le_pow_right (by omega)
  let φS : LevelTop πB (k + 1) →+* LevelTop πB k := Ideal.Quotient.factor hle
  let φR : LevelBase πB s t (k + 1) →+* LevelBase πB s t k := Ideal.Quotient.factor hle'
  have hφS : Function.Surjective φS := Ideal.Quotient.factor_surjective hle
  have hφR : Function.Surjective φR := Ideal.Quotient.factor_surjective hle'
  have hcomm : (levelMap πB s t k).comp φR = φS.comp (levelMap πB s t (k + 1)) :=
    Ideal.Quotient.ringHom_ext (RingHom.ext fun _ => rfl)
  have memI : ∀ a : RingHom.eqLocus s t,
      Ideal.Quotient.mk _ a ∈ RingHom.ker φR ↔ (a : B') ∈ J ^ k := by
    intro a
    rw [RingHom.mem_ker, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]
    rfl
  have memK : ∀ b : B', Ideal.Quotient.mk _ b ∈ RingHom.ker φS ↔ b ∈ J ^ k := by
    intro b
    rw [RingHom.mem_ker, Ideal.Quotient.factor_mk, Ideal.Quotient.eq_zero_iff_mem]
  let ψ := RingHom.quotientKerEquivOfSurjective hφR
  let : Algebra (LevelBase πB s t (k + 1)) (LevelTop πB (k + 1)) :=
    (levelMap πB s t (k + 1)).toAlgebra
  let : Algebra (LevelTop πB (k + 1)) (LevelTop πB k) := φS.toAlgebra
  let : Algebra (LevelBase πB s t (k + 1)) (LevelTop πB k) :=
    (φS.comp (levelMap πB s t (k + 1))).toAlgebra
  have : IsScalarTower (LevelBase πB s t (k + 1)) (LevelTop πB (k + 1)) (LevelTop πB k) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  let ψ' : LevelBase πB s t (k + 1) ⧸ RingHom.ker φR →+* LevelBase πB s t k := ψ.toRingHom
  let : Algebra (LevelBase πB s t (k + 1) ⧸ RingHom.ker φR) (LevelTop πB k) :=
    ((levelMap πB s t k).comp ψ').toAlgebra
  have : IsScalarTower (LevelBase πB s t (k + 1)) (LevelBase πB s t (k + 1) ⧸ RingHom.ker φR)
      (LevelTop πB k) := ⟨fun x y z => by
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    change levelMap πB s t k (ψ (Ideal.Quotient.mk _ (x * y))) * z =
      φS (levelMap πB s t (k + 1) x) * (levelMap πB s t k (ψ (Ideal.Quotient.mk _ y)) * z)
    rw [RingHom.quotientKerEquivOfSurjective_apply_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk, ← RingHom.comp_apply φS,
      ← hcomm, RingHom.comp_apply, map_mul, map_mul, mul_assoc]⟩
  have hflatT : Module.Flat (LevelBase πB s t (k + 1) ⧸ RingHom.ker φR) (LevelTop πB k) := by
    have h1 : @RingHom.Flat _ _ (Ideal.Quotient.commRing (RingHom.ker φR))
        (Ideal.Quotient.commRing _) ψ' := RingHom.Flat.of_bijective ψ.bijective
    exact RingHom.Flat.comp h1 hflat
  have hI2 : RingHom.ker φR ^ 2 = ⊥ := by
    rw [pow_two, eq_bot_iff]
    refine Ideal.mul_le.2 fun x hx y hy => ?_
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [memI] at hx hy
    rw [Ideal.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact h2k (Ideal.mul_mem_mul hx hy)
  have hK2 : RingHom.ker (algebraMap (LevelTop πB (k + 1)) (LevelTop πB k)) ^ 2 = ⊥ := by
    change RingHom.ker φS ^ 2 = ⊥
    rw [pow_two, eq_bot_iff]
    refine Ideal.mul_le.2 fun x hx y hy => ?_
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [memK] at hx hy
    rw [Ideal.mem_bot, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    exact h2k (Ideal.mul_mem_mul hx hy)
  have hsurj : Function.Surjective (algebraMap (LevelTop πB (k + 1)) (LevelTop πB k)) := hφS
  refine ((Ideal.bijective_fibreTensorSMulHomToKer_iff (RingHom.ker φR) (LevelTop πB (k + 1))
    (LevelTop πB k) hI2 hK2 hsurj hflatT).mp ?_).1
  -- the graded descent at level `k`
  let mB : Module B (grPiece πB k) := grPiece.module H.surjective_B k
  let mA : Module A (grPiece πB k) := Module.compHom _ (algebraMap A B)
  have : IsScalarTower A B (grPiece πB k) := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  obtain ⟨M, hM, hbc⟩ := H.exists_isBaseChange_grPiece k
  -- `τ₀ : J^k ⧸ J^(k+1) → B' ⧸ J^(k+1)`
  have hτle : J • (⊤ : Submodule B' ↥(J ^ k)) ≤
      LinearMap.ker ((J ^ (k + 1)).mkQ ∘ₗ (J ^ k).subtype) := by
    intro y hy
    refine Submodule.smul_induction_on hy (fun r hr n _ => ?_) (fun x y hx hy => ?_)
    · rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, Submodule.coe_subtype, Submodule.coe_smul, smul_eq_mul,
        pow_succ']
      exact Ideal.mul_mem_mul hr n.2
    · exact Submodule.add_mem _ hx hy
  let τ₀ : grPiece πB k →ₗ[B'] LevelTop πB (k + 1) :=
    (J • (⊤ : Submodule B' ↥(J ^ k))).liftQ ((J ^ (k + 1)).mkQ ∘ₗ (J ^ k).subtype) hτle
  have hτ : ∀ x : ↥(J ^ k), τ₀ (Submodule.Quotient.mk x) = Ideal.Quotient.mk _ (x : B') :=
    fun _ => rfl
  have hτinj : Function.Injective τ₀ := by
    refine (injective_iff_map_eq_zero τ₀).2 fun ξ hξ => ?_
    obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ ξ
    rw [hτ, Ideal.Quotient.eq_zero_iff_mem] at hξ
    exact (grPiece_mk_eq_zero_iff k x).2 hξ
  -- the classes of invariant functions
  have hcls : ∀ (a : RingHom.eqLocus s t) (ha : (a : B') ∈ J ^ k),
      (Submodule.Quotient.mk ⟨(a : B'), ha⟩ : grPiece πB k) ∈ M := by
    intro a ha
    rw [hM, grMap_mk, grMap_mk]
    congr 2
    exact RingHom.mem_eqLocus.1 a.2
  let rep : LevelBase πB s t (k + 1) → RingHom.eqLocus s t :=
    Function.surjInv Ideal.Quotient.mk_surjective
  have hrep : ∀ x, Ideal.Quotient.mk _ (rep x) = x :=
    Function.surjInv_eq Ideal.Quotient.mk_surjective
  have hrepI : ∀ x : RingHom.ker φR, ((rep x : RingHom.eqLocus s t) : B') ∈ J ^ k := fun x =>
    (memI _).1 (by rw [hrep]; exact x.2)
  let u : RingHom.ker φR → M := fun x =>
    ⟨Submodule.Quotient.mk ⟨_, hrepI x⟩, hcls _ (hrepI x)⟩
  have hu : ∀ (a : RingHom.eqLocus s t) (ha : Ideal.Quotient.mk _ a ∈ RingHom.ker φR),
      (u ⟨_, ha⟩ : grPiece πB k) = Submodule.Quotient.mk ⟨(a : B'), (memI a).1 ha⟩ := by
    intro a ha
    change (Submodule.Quotient.mk ⟨_, hrepI ⟨_, ha⟩⟩ : grPiece πB k) = _
    rw [← sub_eq_zero, ← Submodule.Quotient.mk_sub, grPiece_mk_eq_zero_iff]
    have h := hrep (Ideal.Quotient.mk _ a)
    rw [Ideal.Quotient.eq] at h
    exact h
  let uAdd : RingHom.ker φR →+ M :=
    { toFun := u
      map_zero' := by
        apply Subtype.ext
        have h0 : Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype)
            (0 : RingHom.eqLocus s t) ∈ RingHom.ker φR := by
          rw [map_zero]; exact Ideal.zero_mem _
        have e : (0 : RingHom.ker φR) = ⟨_, h0⟩ := Subtype.ext (map_zero _).symm
        rw [e, hu]
        rfl
      map_add' := fun x y => by
        apply Subtype.ext
        have hxy : Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype)
            (rep x + rep y) ∈ RingHom.ker φR := by
          rw [map_add, hrep, hrep]; exact Ideal.add_mem _ x.2 y.2
        have e : x + y = ⟨_, hxy⟩ := Subtype.ext (by
          change (x : LevelBase πB s t (k + 1)) + (y : LevelBase πB s t (k + 1)) =
            Ideal.Quotient.mk _ (rep x + rep y)
          rw [map_add, hrep, hrep])
        rw [e, hu]
        rfl }
  have uinj : Function.Injective uAdd := by
    refine (injective_iff_map_eq_zero uAdd).2 fun x hx => ?_
    have hx' : (u x : grPiece πB k) = 0 := congrArg Subtype.val hx
    change (Submodule.Quotient.mk ⟨_, hrepI x⟩ : grPiece πB k) = 0 at hx'
    rw [grPiece_mk_eq_zero_iff] at hx'
    apply Subtype.ext
    calc (x : LevelBase πB s t (k + 1)) = Ideal.Quotient.mk _ (rep x) := (hrep x).symm
      _ = 0 := Ideal.Quotient.eq_zero_iff_mem.2 hx'
  have usurj : Function.Surjective uAdd := by
    intro m
    obtain ⟨y, hy⟩ := Submodule.Quotient.mk_surjective _ (m : grPiece πB k)
    have hinv : grMap s H.hs k (Submodule.Quotient.mk y) =
        grMap t H.ht k (Submodule.Quotient.mk y) := by rw [hy]; exact (hM m).1 m.2
    obtain ⟨a, ha, haJ, haeq⟩ := H.exists_mem_eqLocus_grPiece_eq hnil y hinv
    have hI : Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype)
        (⟨a, ha⟩ : RingHom.eqLocus s t) ∈ RingHom.ker φR := (memI _).2 haJ
    refine ⟨⟨_, hI⟩, Subtype.ext ?_⟩
    change (u ⟨_, hI⟩ : grPiece πB k) = m
    rw [hu, ← hy, ← haeq]
  let eU : RingHom.ker φR ≃+ M := AddEquiv.ofBijective uAdd ⟨uinj, usurj⟩
  have heU : ∀ x, (eU x : grPiece πB k) = Submodule.Quotient.mk ⟨_, hrepI x⟩ := fun _ => rfl
  have u_smul : ∀ (a : RingHom.eqLocus s t) (x : RingHom.ker φR),
      eU (Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a • x) =
        H.toBase a • eU x := by
    intro a x
    apply Subtype.ext
    have hab : Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype)
        (a * rep x) ∈ RingHom.ker φR := by
      rw [map_mul, hrep]; exact Ideal.mul_mem_left _ _ x.2
    have e : Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a • x =
        ⟨_, hab⟩ := Subtype.ext (by
      change Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a *
        (x : LevelBase πB s t (k + 1)) = Ideal.Quotient.mk _ _
      rw [map_mul, hrep])
    rw [e]
    change (u ⟨_, hab⟩ : grPiece πB k) = algebraMap A B (H.toBase a) •
      (Submodule.Quotient.mk ⟨_, hrepI x⟩ : grPiece πB k)
    rw [hu, H.algebraMap_toBase]
    exact (grPiece.module_smul H.surjective_B k (a : B')
      (Submodule.Quotient.mk ⟨_, hrepI x⟩ : grPiece πB k)).symm
  have toI_smul : ∀ (a : RingHom.eqLocus s t) (m : M),
      eU.symm (H.toBase a • m) =
        Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a • eU.symm m := by
    intro a m
    apply eU.injective
    rw [eU.apply_symm_apply, u_smul, eU.apply_symm_apply]
  -- `g : B ⊗_A M → I ⊗ (B'/J^k)`
  let G : B' →+ (M →+ RingHom.ker φR ⊗[LevelBase πB s t (k + 1)] LevelTop πB k) :=
    AddMonoidHom.mk' (fun b' => AddMonoidHom.mk'
      (fun m => eU.symm m ⊗ₜ Ideal.Quotient.mk (J ^ k) b')
      (fun m m' => by rw [map_add, TensorProduct.add_tmul]))
      (fun b b' => AddMonoidHom.ext fun m => by
        simp only [map_add, TensorProduct.tmul_add, AddMonoidHom.mk'_apply,
          AddMonoidHom.add_apply])
  have hGJ : ∀ j ∈ J, G j = 0 := by
    have hQ : ∀ x ∈ (J.comap (RingHom.eqLocus s t).subtype).map (RingHom.eqLocus s t).subtype,
        ∀ (m : M) (c : B'), eU.symm m ⊗ₜ[LevelBase πB s t (k + 1)]
          (Ideal.Quotient.mk (J ^ k) (c * x) : LevelTop πB k) = 0 := by
      intro x hx
      induction hx using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, ha, rfl⟩ := hx
        intro m c
        have e : (Ideal.Quotient.mk (J ^ k) (c * (RingHom.eqLocus s t).subtype a) :
            LevelTop πB k) =
              (Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a :
                LevelBase πB s t (k + 1)) •
              Ideal.Quotient.mk (J ^ k) c := by
          rw [Algebra.smul_def, mul_comm, map_mul]
          rfl
        rw [e]
        refine (TensorProduct.smul_tmul (R := LevelBase πB s t (k + 1))
          (R' := LevelBase πB s t (k + 1))
          (Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a)
          (eU.symm m) (Ideal.Quotient.mk (J ^ k) c : LevelTop πB k)).symm.trans ?_
        have h0 : (Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a :
            LevelBase πB s t (k + 1)) • eU.symm m = 0 := by
          apply Subtype.ext
          change Ideal.Quotient.mk ((J ^ (k + 1)).comap (RingHom.eqLocus s t).subtype) a *
            (eU.symm m : LevelBase πB s t (k + 1)) = 0
          rw [← hrep (eU.symm m), ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
          change (a : B') * ((rep (eU.symm m) : RingHom.eqLocus s t) : B') ∈ J ^ (k + 1)
          have hmem := Ideal.mul_mem_mul (Ideal.mem_comap.1 ha) (hrepI (eU.symm m))
          rw [← pow_succ'] at hmem
          exact hmem
        rw [h0, TensorProduct.zero_tmul]
      | zero => intro m c; rw [mul_zero, map_zero, TensorProduct.tmul_zero]
      | add x y _ _ hx hy =>
        intro m c; rw [mul_add, map_add, TensorProduct.tmul_add, hx, hy, add_zero]
      | smul c' x _ hx =>
        intro m c
        rw [smul_eq_mul, ← mul_assoc]
        exact hx m (c * c')
    intro j hj
    refine AddMonoidHom.ext fun m => ?_
    have := hQ j ((H.ker_eq_map_comap hnil).le hj) m 1
    rwa [one_mul] at this
  have hker : πB.toAddMonoidHom.ker ≤ G.ker := fun x hx => by
    rw [AddMonoidHom.mem_ker] at hx ⊢
    exact hGJ x hx
  let G' := πB.toAddMonoidHom.liftOfSurjective H.surjective_B ⟨G, hker⟩
  have hG' : ∀ b', G' (πB b') = G b' := fun b' =>
    AddMonoidHom.liftOfRightInverse_comp_apply _ _ _ ⟨G, hker⟩ b'
  let g : B ⊗[A] M →+ RingHom.ker φR ⊗[LevelBase πB s t (k + 1)] LevelTop πB k :=
    TensorProduct.liftAddHom G' (fun a b m => by
      obtain ⟨a'', rfl⟩ := H.surjective_toBase hnil a
      obtain ⟨b', rfl⟩ := H.surjective_B b
      have e : H.toBase a'' • πB b' = πB ((a'' : B') * b') := by
        rw [Algebra.smul_def, H.algebraMap_toBase, map_mul]
      rw [e, hG', hG']
      change eU.symm m ⊗ₜ Ideal.Quotient.mk (J ^ k) ((a'' : B') * b') =
        eU.symm (H.toBase a'' • m) ⊗ₜ Ideal.Quotient.mk (J ^ k) b'
      rw [toI_smul, TensorProduct.smul_tmul, Algebra.smul_def, map_mul]
      rfl)
  have hg : ∀ (b : B) (m : M), g (b ⊗ₜ m) = G' b m := fun _ _ => rfl
  have hfg : ∀ z, (((RingHom.ker φR).fibreTensorSMulHomToKer (LevelTop πB (k + 1))
      (LevelTop πB k) hK2 hsurj (g z) : _) : LevelTop πB (k + 1)) = τ₀ (hbc.equiv z) := by
    intro z
    induction z using TensorProduct.inductionOn with
    | tmul b m =>
      obtain ⟨b', rfl⟩ := H.surjective_B b
      rw [hg, hG', IsBaseChange.equiv_tmul, Ideal.coe_fibreTensorSMulHomToKer_apply]
      change (RingHom.ker φR).fibreTensorSMulHom _ _ hK2 hsurj (eU.symm m ⊗ₜ
        algebraMap (LevelTop πB (k + 1)) (LevelTop πB k) (Ideal.Quotient.mk _ b')) = _
      rw [Ideal.fibreTensorSMulHom_tmul]
      have hm : (m : grPiece πB k) = Submodule.Quotient.mk ⟨_, hrepI (eU.symm m)⟩ := by
        rw [← heU, eU.apply_symm_apply]
      rw [show M.subtype m = (m : grPiece πB k) from rfl, hm]
      have hx : ((eU.symm m : RingHom.ker φR) : LevelBase πB s t (k + 1)) •
          (Ideal.Quotient.mk _ b' : LevelTop πB (k + 1)) = Ideal.Quotient.mk _
            (((rep (eU.symm m) : RingHom.eqLocus s t) : B') * b') := by
        conv_lhs => rw [← hrep ((eU.symm m : RingHom.ker φR) : LevelBase πB s t (k + 1))]
        rw [Algebra.smul_def, map_mul]
        rfl
      rw [hx]
      change _ = τ₀ (SMul.smul (πB b') (Submodule.Quotient.mk ⟨_, hrepI (eU.symm m)⟩ :
        grPiece πB k))
      rw [grPiece.module_smul, ← Submodule.Quotient.mk_smul, hτ, mul_comm]
      rfl
    | add z z' hz hz' => rw [map_add, map_add, Submodule.coe_add, hz, hz', map_add, map_add]
  have hgs : Function.Surjective g := by
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul x c =>
      obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective c
      refine ⟨πB b' ⊗ₜ eU x, ?_⟩
      rw [hg, hG']
      change eU.symm (eU x) ⊗ₜ _ = _
      rw [eU.symm_apply_apply]
    | add w w' hw hw' =>
      obtain ⟨z, rfl⟩ := hw
      obtain ⟨z', rfl⟩ := hw'
      exact ⟨z + z', map_add g z z'⟩
  refine ⟨fun x y hxy => ?_, fun y => ?_⟩
  · obtain ⟨z, rfl⟩ := hgs x
    obtain ⟨w, rfl⟩ := hgs y
    have hzw : z = w := by
      apply hbc.equiv.injective
      apply hτinj
      rw [← hfg, ← hfg, hxy]
    rw [hzw]
  · obtain ⟨yv, hyv⟩ := y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective yv
    have hb : b ∈ J ^ k := (memK b).1 hyv
    obtain ⟨z, hz⟩ := hbc.equiv.surjective (Submodule.Quotient.mk ⟨b, hb⟩)
    refine ⟨g z, Subtype.ext ?_⟩
    rw [hfg, hz, hτ]

/-- **Page 7, `X → Y` is flat, for a nilpotent `𝒥_X`**: `B'` is flat over the ring of invariant
functions `A' = Ker(B' ⇉ C')`. By induction on `k`, `B'/J^k` is flat over `A'/(J^k ∩ A')`
(`flat_levelMap_one`, `flat_levelMap_succ`), and `J^k = 0` for `k` large. -/
@[montpellier "126, 5–7"]
theorem flat_eqLocus_of_isNilpotent [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB)) : Module.Flat (RingHom.eqLocus s t) B' := by
  have hall : ∀ n : ℕ, (levelMap πB s t (n + 1)).Flat := by
    intro n
    induction n with
    | zero => exact H.flat_levelMap_one hnil
    | succ n ih => exact H.flat_levelMap_succ hnil (by omega) ih
  obtain ⟨N, hN⟩ := hnil
  have hN' : RingHom.ker πB ^ (N + 1) = ⊥ := by
    rw [pow_succ, hN, zero_mul, Submodule.zero_eq_bot]
  have hbijB : Function.Bijective (Ideal.Quotient.mk (RingHom.ker πB ^ (N + 1))) :=
    ⟨(injective_iff_map_eq_zero _).2 fun x hx => by
      rwa [Ideal.Quotient.eq_zero_iff_mem, hN', Ideal.mem_bot] at hx,
      Ideal.Quotient.mk_surjective⟩
  have hbot : (RingHom.ker πB ^ (N + 1)).comap (RingHom.eqLocus s t).subtype = ⊥ := by
    rw [hN']; exact Ideal.comap_bot_of_injective _ Subtype.val_injective
  have hbijA : Function.Bijective (Ideal.Quotient.mk
      ((RingHom.ker πB ^ (N + 1)).comap (RingHom.eqLocus s t).subtype)) :=
    ⟨(injective_iff_map_eq_zero _).2 fun x hx => by
      rwa [Ideal.Quotient.eq_zero_iff_mem, hbot, Ideal.mem_bot] at hx,
      Ideal.Quotient.mk_surjective⟩
  have hcomm : (Ideal.Quotient.mk (RingHom.ker πB ^ (N + 1))).comp
      (RingHom.eqLocus s t).subtype = (levelMap πB s t (N + 1)).comp (Ideal.Quotient.mk _) :=
    RingHom.ext fun _ => rfl
  have hι : ((RingHom.eqLocus s t).subtype).Flat := by
    rw [← RingHom.Flat.comp_iff_of_bijective_left hbijB, hcomm]
    exact RingHom.Flat.comp (RingHom.Flat.of_bijective hbijA) (hall N)
  exact hι

/-- The ideal `𝒥_Y = J ∩ A'` is nilpotent when `J` is. -/
theorem isNilpotent_ker_toBase [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB)) : ∃ n, RingHom.ker H.toBase ^ n = ⊥ := by
  obtain ⟨N, hN⟩ := hnil
  refine ⟨N, eq_bot_iff.2 ?_⟩
  rw [(H.ker_toBase_eq_and_surjective ⟨N, hN⟩).1]
  refine (Ideal.le_comap_pow _ N).trans ?_
  rw [hN, Submodule.zero_eq_bot, Ideal.comap_bot_of_injective _ Subtype.val_injective]

/-- **Page 7, affine case, for a nilpotent `𝒥_X`**: `Y = Spec A'` with `A' = Ker(B' ⇉ C')`;
`X → Y` is flat and a map `B' ⊗_{A'} B' → C''` into a flat `B'`-algebra which is bijective
modulo `𝒥_Y = J ∩ A'` is bijective. -/
@[montpellier "126, 5–7"]
theorem flat_and_bijective_of_isNilpotent [Module.FaithfullyFlat A B]
    (hnil : IsNilpotent (RingHom.ker πB))
    {C'' : Type u} [CommRing C''] [Algebra (RingHom.eqLocus s t) C''] [Algebra B' C'']
    [IsScalarTower (RingHom.eqLocus s t) B' C''] [Module.Flat B' C'']
    (φ : B' ⊗[RingHom.eqLocus s t] B' →ₐ[RingHom.eqLocus s t] C'')
    (hφ : Function.Bijective
      (LinearMap.lTensor (RingHom.eqLocus s t ⧸ RingHom.ker H.toBase) φ.toLinearMap)) :
    Module.Flat (RingHom.eqLocus s t) B' ∧ Function.Bijective φ := by
  have hB' := H.flat_eqLocus_of_isNilpotent hnil
  have : Module.Flat (RingHom.eqLocus s t) C'' := Module.Flat.trans _ B' C''
  obtain ⟨n, hn⟩ := H.isNilpotent_ker_toBase hnil
  have h := Folder126NilpotentQuotient.bijective_of_lTensor_quotient_nilpotent_of_flat
    (RingHom.ker H.toBase) n hn φ.toLinearMap hφ
  rw [AlgHom.coe_toLinearMap] at h
  exact ⟨hB', h⟩

end IsThickenedNerve

end Nerve

