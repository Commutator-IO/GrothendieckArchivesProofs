module

public import Mathlib.RingTheory.Ideal.IdempotentFG
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Nilpotent.Lemmas
public import OpenProblems.Findings.Folder161_2
import Grothendieck.Attr

/-!
# Folder 161-2, pages 41–42: a map into a pseudo-field from maps into its residue fields

Proof of `OpenProblems.Findings.Folder161_2.RingHomOfResidueFields` (finding
`161-2-pseudofield-opens-by-residue-fields`, issue Commutator-IO/grothendieck-project#186): for a
finitely presented commutative ring `A` and a von Neumann regular commutative ring `R`, if every
residue field `R ⧸ 𝔪` receives a ring map from `A`, then `R` does. This is the local-global
principle behind the description of the open subtopoi of the classifying topos of pseudo-fields
by fields.

**What the formalisation finds.** Nothing false. Quasi-compactness of `Spec R` and the
orthogonalisation of the idempotents are used only through ideals: a finite family of idempotents
`g_i` with `(1 - g_i)` generating `R` is enough, and the Chinese remainder theorem glues the maps
one idempotent at a time.

## Main results

* `exists_fg_le_of_ringHom`: for `A` finitely presented and any ideal `m` of any ring `R`, a map
  `A → R ⧸ m` lifts to `A → R ⧸ K` for a finitely generated ideal `K ≤ m`;
* `exists_ringHom_of_forall_isMaximal`: the lemma, for a von Neumann regular `R`;
* `ringHomOfResidueFields`: the statement `RingHomOfResidueFields`.

## Implementation notes

The proof follows the edition's. A map `A → R ⧸ 𝔪` lifts on a clopen neighbourhood of `𝔪`: the
images of the generators of `A = ℤ[x₁, …, xₙ] ⧸ (f₁, …, f_k)` lift to `R`, the images of the `f_j`
lie in `𝔪` and generate a finitely generated ideal `K ≤ 𝔪`, and in a von Neumann regular ring
`K = (g)` with `g` idempotent (`Ideal.isIdempotentElem_iff_of_fg`), so the lift is a map
`A → R ⧸ (g)`, the ring of the clopen `D(1 - g) ∋ 𝔪`. The elements `1 - g` so obtained generate the
unit ideal (no maximal ideal contains them all), hence finitely many do: this is the
quasi-compactness of `Spec R`. Gluing along them by induction, a map `A → R ⧸ J` is kept with
`J ≤ 𝔭` for every prime `𝔭` not containing all the `1 - g` used so far; to add `g`, the ideals
`(g)` and `J ⊔ (1 - g)` are comaximal, and the Chinese remainder theorem gives a map to
`R ⧸ ((g) ⊓ (J ⊔ (1 - g)))` (this is the orthogonalisation of the idempotents). At the end `J` lies
in every prime, so in the nilradical, which is `0` since `R` is reduced, and `R ⧸ ⊥ ≃ R`.

Von Neumann regularity is the elementwise condition `∀ a, ∃ b, a * a * b = a`, as in
`Grothendieck/CategoryTheory/Folder161_2Classifying.lean`. It is used twice: every ideal is
idempotent, and `R` is reduced.

## Not formalised

The edition's counterexample when `A` is only countably presented.

## References

* A. Grothendieck, folder 161-2, pp. 41–42, *Algèbre universelle* (finding
  `161-2-pseudofield-opens-by-residue-fields`)
-/

@[expose] public section

namespace Grothendieck.Folder161_2

open OpenProblems.Findings.Folder161_2

variable {A R : Type*} [CommRing A] [CommRing R]

/-- **The lift.** For `A` finitely presented over `ℤ` and an ideal `m` of `R`, a ring map
`A → R ⧸ m` lifts to a ring map `A → R ⧸ K` for some finitely generated ideal `K ≤ m`: lift the
images of the generators of `A` to `R`, and take for `K` the ideal generated by the images of the
relations. -/
@[montpellier "161-2, 41–42"]
theorem exists_fg_le_of_ringHom [Algebra.FinitePresentation ℤ A] {m : Ideal R}
    (φ : A →+* R ⧸ m) : ∃ K : Ideal R, K.FG ∧ K ≤ m ∧ Nonempty (A →+* R ⧸ K) := by
  obtain ⟨n, f, hf, s, hs⟩ := ‹Algebra.FinitePresentation ℤ A›
  choose r hr using fun i => Ideal.Quotient.mk_surjective (φ (f (MvPolynomial.X i)))
  set ψ := MvPolynomial.eval₂Hom (Int.castRingHom R) r
  have hψ : (Ideal.Quotient.mk m).comp ψ = φ.comp f.toRingHom :=
    MvPolynomial.ringHom_ext (fun _ => by simp [ψ]) (fun i => by simp [ψ, hr])
  refine ⟨(RingHom.ker f.toRingHom).map ψ, (hs ▸ ⟨s, rfl⟩ : Ideal.FG _).map ψ,
    Ideal.map_le_iff_le_comap.mpr fun p hp => ?_, ⟨?_⟩⟩
  · rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem, ← RingHom.comp_apply, hψ,
      RingHom.comp_apply, RingHom.mem_ker.mp hp, map_zero]
  · exact (Ideal.Quotient.lift _ ((Ideal.Quotient.mk _).comp ψ) fun p hp =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hp)).comp
      (RingHom.quotientKerEquivOfSurjective hf).symm.toRingHom

/-- **Pages 41–42, the local-global lemma.** Let `A` be a finitely presented commutative ring and
`R` a von Neumann regular commutative ring (every `a` has some `b` with `a² b = a`). If every
residue field `R ⧸ 𝔪`, `𝔪` maximal, receives a ring map from `A`, then there is a ring map
`A → R`. -/
@[montpellier "161-2, 41–42"]
theorem exists_ringHom_of_forall_isMaximal [Algebra.FinitePresentation ℤ A]
    (hR : ∀ a : R, ∃ b, a * a * b = a)
    (h : ∀ m : Ideal R, m.IsMaximal → Nonempty (A →+* R ⧸ m)) : Nonempty (A →+* R) := by
  -- The complements `1 - g` of the clopens `V(g)` over which a map `A → R ⧸ (g)` exists.
  set T := {x : R | ∃ g, IsIdempotentElem g ∧ x = 1 - g ∧ Nonempty (A →+* R ⧸ Ideal.span {g})}
  have hT : Ideal.span T = ⊤ := by
    by_contra hne
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨K, hK, hKm, ⟨φ⟩⟩ := exists_fg_le_of_ringHom (h m hm).some
    have hKK : IsIdempotentElem K := le_antisymm Ideal.mul_le_right fun x hx => by
      obtain ⟨b, hb⟩ := hR x
      rw [← hb, mul_assoc]
      exact Ideal.mul_mem_mul hx (K.mul_mem_right b hx)
    obtain ⟨g, hg, rfl⟩ := (Ideal.isIdempotentElem_iff_of_fg K hK).mp hKK
    exact hm.ne_top ((Ideal.eq_top_iff_one _).mpr (by
      simpa using add_mem (hKm (Ideal.mem_span_singleton_self g))
        (hle (Ideal.subset_span ⟨g, hg, rfl, ⟨φ⟩⟩))))
  obtain ⟨s, hsT, hs⟩ := (Ideal.span_eq_top_iff_finite T).mp hT
  -- Gluing along finitely many of them.
  have key : ∀ t : Finset R, ↑t ⊆ T → ∃ J : Ideal R, Nonempty (A →+* R ⧸ J) ∧
      ∀ p : Ideal R, p.IsPrime → ¬ (↑t ⊆ (p : Set R)) → J ≤ p := by
    classical
    intro t
    induction t using Finset.induction_on with
    | empty =>
      have : Subsingleton (R ⧸ (⊤ : Ideal R)) := Ideal.Quotient.subsingleton_iff.mpr rfl
      exact fun _ => ⟨⊤, ⟨⟨⟨⟨fun _ => 0, Subsingleton.elim _ _⟩, fun _ _ => Subsingleton.elim _ _⟩,
        rfl, fun _ _ => Subsingleton.elim _ _⟩⟩, fun p _ h => (h (by simp)).elim⟩
    | insert x t hx ih =>
      intro hxt
      rw [Finset.coe_insert, Set.insert_subset_iff] at hxt
      obtain ⟨J, ⟨φ⟩, hJ⟩ := ih hxt.2
      obtain ⟨g, hg, rfl, ⟨ψ⟩⟩ := hxt.1
      have hcop : IsCoprime (Ideal.span {g}) (J ⊔ Ideal.span {1 - g}) := by
        rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one]
        simpa using add_mem (Ideal.mem_sup_left (Ideal.mem_span_singleton_self g))
          (Ideal.mem_sup_right (Ideal.mem_sup_right (Ideal.mem_span_singleton_self (1 - g))))
      refine ⟨_, ⟨(Ideal.quotientInfEquivQuotientProd _ _ hcop).symm.toRingHom.comp
        (ψ.prod ((Ideal.Quotient.factor le_sup_left).comp φ))⟩, fun p hp hpt => ?_⟩
      by_cases h1 : 1 - g ∈ p
      · have : ¬ ↑t ⊆ (p : Set R) := fun ht => hpt (by simp [Set.insert_subset_iff, h1, ht])
        exact inf_le_right.trans
          (sup_le (hJ p hp this) ((Ideal.span_singleton_le_iff_mem _).mpr h1))
      · have : g * (1 - g) ∈ p := hg.mul_one_sub_self ▸ p.zero_mem
        exact inf_le_left.trans
          ((Ideal.span_singleton_le_iff_mem _).mpr ((hp.mem_or_mem this).resolve_right h1))
  obtain ⟨J, ⟨φ⟩, hJ⟩ := key s hsT
  have : IsReduced R := (isReduced_iff_pow_one_lt 2 one_lt_two).mpr fun x hx => by
    obtain ⟨b, hb⟩ := hR x
    rw [← hb, ← sq, hx, zero_mul]
  have hJ0 : J = ⊥ := le_bot_iff.mp <| by
    rw [← Ideal.zero_eq_bot, ← nilradical_eq_zero R, nilradical_eq_sInf]
    exact le_sInf fun p hp => hJ p hp fun hsp => hp.ne_top (by
      rw [eq_top_iff, ← hs]; exact Ideal.span_le.mpr hsp)
  subst hJ0
  exact ⟨(RingEquiv.quotientBot R).toRingHom.comp φ⟩

universe u v in
/-- **Pages 41–42.** The statement `RingHomOfResidueFields` holds. -/
@[montpellier "161-2, 41–42"]
theorem ringHomOfResidueFields : RingHomOfResidueFields.{u, v} :=
  fun _ _ _ _ _ => exists_ringHom_of_forall_isMaximal

end Grothendieck.Folder161_2
