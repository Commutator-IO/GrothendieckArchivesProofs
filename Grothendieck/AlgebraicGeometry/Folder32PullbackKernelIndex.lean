module

public import Mathlib.CategoryTheory.Preadditive.Basic
public import Mathlib.RingTheory.Int.Basic
import Grothendieck.Attr

/-!
# Folder 32, pages 10–11: the kernel of a pullback is killed by the index, the algebraic core

Finding `32-pullback-kernel-index`. For `f : X → Y` proper over a field, `Y` irreducible and smooth
with generic point `η`, `X_η` non-empty and `N` the gcd of the degrees of the closed points of
`X_η`, the page builds a map `t : H^*(X, G_X) → H^*(Y, G)`, functorial in `G`, with `t f^* = N`, so
that `Ker f^*` is killed by `N`. The statements are
`OpenProblems.Findings.Folder32.PullbackTraceIndex` and `PullbackKernelIndex`.

**Those statements are not proved here.** The page's computation takes closed points `x_i` of `X_η`
of degrees `n_i`, Bézout coefficients `Σ d_i n_i = N`, the closures `u_i : Z_i → X` and
`f_i = f u_i`, and writes `(Σ d_i f_{i*} u_i^*) f^* = Σ d_i f_{i*} f_i^* = Σ d_i n_i = N`, using
`f_{i*} f_i^* = n_i`, that is `Tr_{f_i}(1) = n_i`. The Gysin maps `f_{i*}` and that identity are
the folder's § 4 and are **hypotheses** here: neither Mathlib nor the Stacks library has them for
finite non-étale multisections. What this file proves is the rest of the computation, the step
from the `n_i` to their gcd, which is linear algebra.

## Main results

* `exists_mem_closure_comp_eq_smul`: for `R`-linear maps `p : A → B` and `t_i : B → A` with
  `t_i ∘ p = n_i`, every `m` in the subgroup of `ℤ` generated by the `n_i` is `u ∘ p` for an
  integer combination `u` of the `t_i`; and then `m` kills `Ker p`
  (`smul_eq_zero_of_mem_closure`).
* `exists_comp_eq_gcd_smul`, `gcd_smul_eq_zero`: the page's case, finitely many `t_i` and
  `m = N = gcd n_i`.
* `exists_mem_closure_comp_eq_zsmul_id`, `exists_comp_eq_gcd_zsmul_id`: the same in a preadditive
  category. Applied in a functor category `C ⥤ ModuleCat R`, where the morphisms are natural
  transformations, it says that an integer combination of maps `t_i` natural in the coefficients
  `G` is natural: the functoriality in `G` of the page's map, given that of the `f_{i*} u_i^*`.

## Implementation notes

The subgroup of `ℤ` generated by the `n_i` is the one of the findings file. The set of `m`
reached by integer combinations of the `t_i` is a subgroup containing every `n_i`
(`AddSubgroup.closure_induction`). For the gcd, Bézout over `ℤ` is `Finset.gcd_eq_sum_mul`, and the
coefficients `d_i` it gives are those of the combination `Σ d_i t_i`. The linear statements are
pointwise (`u (p a) = m • a`), as in the findings file, rather than equalities of maps.

## Not formalised

* The étale cohomology of the statement, the closures `Z_i`, the Gysin maps `f_{i*}` and the
  identity `f_{i*} f_i^* = n_i` (equivalently `Tr_f(1) = N`), all taken as hypotheses.

## References

* A. Grothendieck, folder 32, pp. 10–11 (finding `32-pullback-kernel-index`)
-/

@[expose] public section

open CategoryTheory

namespace Grothendieck.Folder32

section Linear

variable {R A B ι : Type*} [Ring R] [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]

/-- `32-pullback-kernel-index` (folder 32, p. 10), the step from the `n_i` to the subgroup they
generate. If `t_i ∘ p = n_i • id` for every `i`, then for every `m` in the subgroup of `ℤ`
generated by the `n_i` some integer combination `u` of the `t_i` has `u ∘ p = m • id`. The `t_i`
are the page's `f_{i*} u_i^*` and the identities `t_i ∘ p = n_i` its `f_{i*} f_i^* = n_i`, which
are hypotheses. -/
@[montpellier "32, 10"]
theorem exists_mem_closure_comp_eq_smul (p : A →ₗ[R] B) (t : ι → B →ₗ[R] A) (n : ι → ℤ)
    (ht : ∀ i a, t i (p a) = n i • a) {m : ℤ} (hm : m ∈ AddSubgroup.closure (Set.range n)) :
    ∃ u ∈ AddSubgroup.closure (Set.range t), ∀ a, u (p a) = m • a := by
  refine AddSubgroup.closure_induction ?_ ⟨0, zero_mem _, by simp⟩ ?_ ?_ hm
  · rintro _ ⟨i, rfl⟩
    exact ⟨t i, AddSubgroup.subset_closure ⟨i, rfl⟩, ht i⟩
  · rintro _ _ - - ⟨u, hu, hu'⟩ ⟨v, hv, hv'⟩
    exact ⟨u + v, add_mem hu hv, by simp [hu', hv', add_smul]⟩
  · rintro _ - ⟨u, hu, hu'⟩
    exact ⟨-u, neg_mem hu, by simp [hu']⟩

/-- `32-pullback-kernel-index` (folder 32, p. 11), the consequence: under the hypotheses of
`exists_mem_closure_comp_eq_smul`, every `m` in the subgroup generated by the `n_i` kills
`Ker p`. -/
@[montpellier "32, 11"]
theorem smul_eq_zero_of_mem_closure (p : A →ₗ[R] B) (t : ι → B →ₗ[R] A) (n : ι → ℤ)
    (ht : ∀ i a, t i (p a) = n i • a) {m : ℤ} (hm : m ∈ AddSubgroup.closure (Set.range n))
    {a : A} (ha : p a = 0) : m • a = 0 := by
  obtain ⟨u, -, hu⟩ := exists_mem_closure_comp_eq_smul p t n ht hm
  rw [← hu, ha, map_zero]

/-- `32-pullback-kernel-index` (folder 32, p. 10), the page's computation from Bézout on: for
finitely many `t_i` with `t_i ∘ p = n_i • id`, there are integers `d_i` with
`(Σ d_i t_i) ∘ p = N • id`, `N = gcd n_i`. -/
@[montpellier "32, 10"]
theorem exists_comp_eq_gcd_smul (s : Finset ι) (p : A →ₗ[R] B) (t : ι → B →ₗ[R] A) (n : ι → ℤ)
    (ht : ∀ i ∈ s, ∀ a, t i (p a) = n i • a) :
    ∃ d : ι → ℤ, ∀ a, (∑ i ∈ s, d i • t i) (p a) = s.gcd n • a := by
  obtain ⟨d, hd⟩ := s.gcd_eq_sum_mul n
  refine ⟨d, fun a => ?_⟩
  rw [hd, Finset.sum_smul, LinearMap.sum_apply]
  exact Finset.sum_congr rfl fun i hi => by rw [LinearMap.smul_apply, ht i hi, smul_smul, mul_comm]

/-- `32-pullback-kernel-index` (folder 32, p. 11): `Ker p` is killed by `N = gcd n_i`. -/
@[montpellier "32, 11"]
theorem gcd_smul_eq_zero (s : Finset ι) (p : A →ₗ[R] B) (t : ι → B →ₗ[R] A) (n : ι → ℤ)
    (ht : ∀ i ∈ s, ∀ a, t i (p a) = n i • a) {a : A} (ha : p a = 0) : s.gcd n • a = 0 := by
  obtain ⟨d, hd⟩ := exists_comp_eq_gcd_smul s p t n ht
  rw [← hd, ha, map_zero]

end Linear

section Preadditive

variable {C : Type*} [Category C] [Preadditive C] {X Y : C} {ι : Type*}

/-- `32-pullback-kernel-index` (folder 32, p. 10), in a preadditive category: if
`p ≫ t i = n i • 𝟙 X` for every `i`, every `m` in the subgroup of `ℤ` generated by the `n_i` is
`p ≫ u` for an integer combination `u` of the `t i`. In the category `C ⥤ ModuleCat R` the
morphisms are natural transformations, so this gives the functoriality in the coefficients of the
page's map, given that of the `t i`. -/
@[montpellier "32, 10"]
theorem exists_mem_closure_comp_eq_zsmul_id (p : X ⟶ Y) (t : ι → (Y ⟶ X)) (n : ι → ℤ)
    (ht : ∀ i, p ≫ t i = n i • 𝟙 X) {m : ℤ} (hm : m ∈ AddSubgroup.closure (Set.range n)) :
    ∃ u ∈ AddSubgroup.closure (Set.range t), p ≫ u = m • 𝟙 X := by
  refine AddSubgroup.closure_induction ?_ ⟨0, zero_mem _, by simp⟩ ?_ ?_ hm
  · rintro _ ⟨i, rfl⟩
    exact ⟨t i, AddSubgroup.subset_closure ⟨i, rfl⟩, ht i⟩
  · rintro _ _ - - ⟨u, hu, hu'⟩ ⟨v, hv, hv'⟩
    exact ⟨u + v, add_mem hu hv, by simp [hu', hv', add_smul]⟩
  · rintro _ - ⟨u, hu, hu'⟩
    exact ⟨-u, neg_mem hu, by simp [hu']⟩

/-- `32-pullback-kernel-index` (folder 32, p. 10), in a preadditive category, the page's
computation from Bézout on: `p ≫ Σ d_i t_i = N • 𝟙 X` with `N = gcd n_i`. -/
@[montpellier "32, 10"]
theorem exists_comp_eq_gcd_zsmul_id (s : Finset ι) (p : X ⟶ Y) (t : ι → (Y ⟶ X)) (n : ι → ℤ)
    (ht : ∀ i ∈ s, p ≫ t i = n i • 𝟙 X) :
    ∃ d : ι → ℤ, p ≫ ∑ i ∈ s, d i • t i = s.gcd n • 𝟙 X := by
  obtain ⟨d, hd⟩ := s.gcd_eq_sum_mul n
  refine ⟨d, ?_⟩
  rw [hd, Finset.sum_smul, Preadditive.comp_sum]
  exact Finset.sum_congr rfl fun i hi => by
    rw [Preadditive.comp_zsmul, ht i hi, smul_smul, mul_comm]

end Preadditive

end Grothendieck.Folder32
