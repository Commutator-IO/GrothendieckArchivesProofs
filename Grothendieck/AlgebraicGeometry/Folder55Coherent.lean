module

public import Grothendieck.AlgebraicGeometry.Folder55Sheaf
public import Grothendieck.AlgebraicGeometry.Folder55Generation
public import Mathlib.Algebra.Category.Ring.FilteredColimits

@[expose] public section

/-!
# Folder 55, page 13: the structure sheaf of the counterexample is coherent

The ring data are those of `Grothendieck.Folder55LemmaB` with `k` a field, `D` noetherian, `K` a
field which is a localisation `D[1/T]` with `ε T = 0`, and `ι = algebraMap D K` injective; for
`k⟦X⟧ ⊂ k⸨X⸩` and `T = X` these hold (`Grothendieck/AlgebraicGeometry/Folder55Ideals.lean`).

**Coherence** (`isCoherent_O`, Stacks 01BV, `Stacks.SheafOfModules.IsCoherent`) is proved through
the sectionwise criterion of Stacks 03DL (`Stacks.SheafOfModules.Site.isCoherent_of_
isFiniteTypeSections`): `𝒪` is generated by `1`, and for finitely many sections `s i` over `U`,
every point of `U` has a neighbourhood on which the relations among the `s i` are generated by
finitely many of them (`exists_gen`).

* At `infty`, on a basic neighbourhood `B_N` the `s i` are constants of `k` (`gen_infty`); at
  `e n`, on `{e n, o n}`, they are constants of `k` (`gen_e`); at `o n` and `d n` they are
  elements of `K` (`gen_o`, `gen_d`). In each case they come from a field, and either all vanish
  or one is a unit (`Folder55Generation.exists_generatesLocally_of_field`).
* At the node `c n`, `𝒪({c n, o n, d n})` is the ring of pairs in `D × D` with equal constant
  terms, a finite `D`-module, hence noetherian (`isNoetherianRing_cOpen`), so the relations over
  `{c n, o n, d n}` are finitely generated (`exists_gens_cOpen`). Restriction to `{o n}` is a
  localisation at `(T, 0)`, to `{d n}` at `(0, T)`, so they still generate there (`gen_c`,
  `Folder55Generation.exists_sum_eq_of_localization`).

**The stalks** (`isNoetherianRing_stalk`) are images of `k` at `infty` and at `e n`, of the
noetherian ring `𝒪({c n, o n, d n})` at `c n`, and of `K` at `o n` and `d n`.
-/

open CategoryTheory TopologicalSpace Opposite Stacks.SheafOfModules Grothendieck.Folder55Generation
namespace Grothendieck.Folder55LemmaB
open Pt

/-! ### The smallest neighbourhoods -/

/-- The points `c n`, `o n`, `d n`. -/
def InC (n : ℕ) : Pt → Prop
  | infty => False
  | c m => m = n
  | e _ => False
  | o m => m = n
  | d m => m = n

/-- The smallest open neighbourhood `{c n, o n, d n}` of `c n`. -/
def cOpen (n : ℕ) : Opens Xsp :=
  ⟨{y | InC n y}, ⟨fun _ h => ⟨h, h⟩, fun _ h => (h : False).elim, fun h => (h : False).elim⟩⟩

/-- The point `o n`. -/
def InO (n : ℕ) : Pt → Prop
  | o m => m = n
  | _ => False

/-- The point `d n`. -/
def InD (n : ℕ) : Pt → Prop
  | d m => m = n
  | _ => False

/-- The open point `{o n}`. -/
def oOpen (n : ℕ) : Opens Xsp :=
  ⟨{y | InO n y}, ⟨fun _ h => (h : False).elim, fun _ h => (h : False).elim,
    fun h => (h : False).elim⟩⟩

/-- The open point `{d n}`. -/
def dOpen (n : ℕ) : Opens Xsp :=
  ⟨{y | InD n y}, ⟨fun _ h => (h : False).elim, fun _ h => (h : False).elim,
    fun h => (h : False).elim⟩⟩

theorem cOpen_le {U : Opens Xsp} {n : ℕ} (h : c n ∈ U) : cOpen n ≤ U := by
  intro y hy
  cases y with
  | infty => exact (hy : False).elim
  | c m => obtain rfl : m = n := hy; exact h
  | e m => exact (hy : False).elim
  | o m => obtain rfl : m = n := hy; exact mem_o_of_c h
  | d m => obtain rfl : m = n := hy; exact mem_d_of_c h

theorem eoOpen_le {U : Opens Xsp} {n : ℕ} (h : e n ∈ U) : eoOpen n ≤ U := by
  intro y hy
  cases y with
  | infty => exact (hy : False).elim
  | c m => exact (hy : False).elim
  | e m => obtain rfl : m = n := hy; exact h
  | o m => obtain rfl : m = n := hy; exact mem_o_of_e h
  | d m => exact (hy : False).elim

theorem oOpen_le {U : Opens Xsp} {n : ℕ} (h : o n ∈ U) : oOpen n ≤ U := by
  intro y hy
  cases y with
  | o m => obtain rfl : m = n := hy; exact h
  | _ => exact (hy : False).elim

theorem dOpen_le {U : Opens Xsp} {n : ℕ} (h : d n ∈ U) : dOpen n ≤ U := by
  intro y hy
  cases y with
  | d m => obtain rfl : m = n := hy; exact h
  | _ => exact (hy : False).elim

variable {k D K : Type} [CommRing k] [CommRing D] [CommRing K] (κ : k →+* D) (ε : D →+* k)
  (ι : D →+* K)

/-- Every function on an open set without `c`, `e` or `infty` is a section of `𝒪`. -/
theorem mem_O_of_generic {W : Opens Xsp} (hc : ∀ m, c m ∉ W) (he : ∀ m, e m ∉ W)
    (hi : (infty : Xsp) ∉ W) (s : Sec k D K W) : s ∈ (O κ ε ι).sections W :=
  ⟨fun m h => (hc m h).elim, fun m h => (he m h).elim, fun h => (hi h).elim⟩

/-- The sections of `𝒪` commute. -/
theorem Opre_comm (W : Opens Xsp) (a b : (Opre κ ε ι).obj (op W)) : a * b = b * a :=
  Subtype.ext (mul_comm a.1 b.1)

theorem Opre_map_apply {W W' : Opens Xsp} (h : W' ≤ W) (a : (Opre κ ε ι).obj (op W))
    (y : W') : ((Opre κ ε ι).map (homOfLE h).op a).1 y = a.1 ⟨y.1, h y.2⟩ := rfl

/-- The constant sections, a ring map `k → 𝒪(W)`. -/
def constSec (W : Opens Xsp) : k →+* (Opre κ ε ι).obj (op W) where
  toFun a := ⟨fun y => constHom κ ι y.1 a,
    ⟨fun _ _ => ⟨rfl, rfl, rfl⟩, fun _ _ => rfl, fun _ => ⟨0, fun _ _ => rfl⟩⟩⟩
  map_one' := Subtype.ext (funext fun y => map_one (constHom κ ι y.1))
  map_mul' a b := Subtype.ext (funext fun y => map_mul (constHom κ ι y.1) a b)
  map_zero' := Subtype.ext (funext fun y => map_zero (constHom κ ι y.1))
  map_add' a b := Subtype.ext (funext fun y => map_add (constHom κ ι y.1) a b)

/-- The value `a ∈ K` at the points `o m` and `d m`, and `0` elsewhere. -/
def valOD (a : K) : (y : Pt) → Val k D K y
  | infty => 0
  | c _ => 0
  | e _ => 0
  | o _ => a
  | d _ => a

/-- Sections over an open set of points `o m`, `d m`: a ring map `K → 𝒪(W)`. -/
def odSec (W : Opens Xsp) (hc : ∀ m, c m ∉ W) (he : ∀ m, e m ∉ W) (hi : (infty : Xsp) ∉ W) :
    K →+* (Opre κ ε ι).obj (op W) where
  toFun a := ⟨fun y => valOD (k := k) (D := D) a y.1, mem_O_of_generic κ ε ι hc he hi _⟩
  map_one' := Subtype.ext (funext fun ⟨y, hy⟩ => by
    cases y with
    | infty => exact (hi hy).elim
    | c m => exact (hc m hy).elim
    | e m => exact (he m hy).elim
    | o m => rfl
    | d m => rfl)
  map_mul' a b := Subtype.ext (funext fun ⟨y, hy⟩ => by
    cases y with
    | infty => exact (hi hy).elim
    | c m => exact (hc m hy).elim
    | e m => exact (he m hy).elim
    | o m => rfl
    | d m => rfl)
  map_zero' := Subtype.ext (funext fun ⟨y, hy⟩ => by
    cases y with
    | infty => rfl
    | c m => rfl
    | e m => rfl
    | o m => rfl
    | d m => rfl)
  map_add' a b := Subtype.ext (funext fun ⟨y, hy⟩ => by
    cases y with
    | infty => exact (hi hy).elim
    | c m => exact (hc m hy).elim
    | e m => exact (he m hy).elim
    | o m => rfl
    | d m => rfl)

theorem oOpen_c (n m : ℕ) : c m ∉ oOpen n := fun h => (h : False)
theorem oOpen_e (n m : ℕ) : e m ∉ oOpen n := fun h => (h : False)
theorem oOpen_i (n : ℕ) : (infty : Xsp) ∉ oOpen n := fun h => (h : False)
theorem dOpen_c (n m : ℕ) : c m ∉ dOpen n := fun h => (h : False)
theorem dOpen_e (n m : ℕ) : e m ∉ dOpen n := fun h => (h : False)
theorem dOpen_i (n : ℕ) : (infty : Xsp) ∉ dOpen n := fun h => (h : False)


/-! ### Local generators of the relations at `infty`, `e n`, `o n`, `d n` -/

section Generic

variable {U : Opens Xsp} {m : ℕ} (s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U))

/-- The neighbourhoods on which relations are generated. -/
abbrev Gen (U : Opens Xsp) (s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U))
    (U' : Opens Xsp) : Prop :=
  ∃ (hU' : U' ≤ U) (N : ℕ)
    (v : Fin N → (relationsPresheaf (PresheafOfModules.unit (Opre κ ε ι)) s).obj
      (op (Over.mk (homOfLE hU')))),
    GeneratesLocally ((Opens.grothendieckTopology Xsp).over U)
      (relationsPresheaf (PresheafOfModules.unit (Opre κ ε ι)) s) v

theorem sec_mem (a : (PresheafOfModules.unit (Opre κ ε ι)).obj (op U)) :
    (a : (Opre κ ε ι).obj (op U)).1 ∈ (O κ ε ι).sections U :=
  (a : (Opre κ ε ι).obj (op U)).2

/-- **At `infty`**: on a basic neighbourhood the sections are constants of the field `k`. -/
theorem gen_infty {k : Type} [Field k] (κ : k →+* D) (ε : D →+* k)
    {s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U)} (hU : (infty : Xsp) ∈ U) :
    ∃ U', (infty : Xsp) ∈ U' ∧ Gen κ ε ι U s U' := by
  have hI := fun i => ((sec_mem κ ε ι (s i)).2.2) hU
  choose N hN using hI
  obtain ⟨M, hM⟩ := exists_basicOpen_le hU
  let N₀ := M + ∑ i, N i
  have hN₀ : ∀ i, N i ≤ N₀ := fun i => le_add_left
    (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i))
  have hle : basicOpen N₀ ≤ U := le_trans (basic_anti (Nat.le_add_right M _)) hM
  refine ⟨basicOpen N₀, trivial, hle, ?_⟩
  refine ⟨m, exists_generatesLocally_of_field s (Opre_comm κ ε ι) (Over.mk (homOfLE hle))
    (constSec κ ε ι (basicOpen N₀)) fun i => ⟨atInf (s i : (Opre κ ε ι).obj (op U)).1 hU, ?_⟩⟩
  refine Subtype.ext (funext fun y => ?_)
  exact hN i ⟨y.1, hle y.2⟩ (inBasic_anti (hN₀ i) _ y.2)

/-- **At `e n`**: on `{e n, o n}` the sections are constants of the field `k`. -/
theorem gen_e {k : Type} [Field k] (κ : k →+* D) (ε : D →+* k)
    {s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U)} {n : ℕ} (hU : e n ∈ U) :
    ∃ U', e n ∈ U' ∧ Gen κ ε ι U s U' := by
  have hle := eoOpen_le hU
  refine ⟨eoOpen n, (rfl : n = n), hle, ?_⟩
  refine ⟨m, exists_generatesLocally_of_field s (Opre_comm κ ε ι) (Over.mk (homOfLE hle))
    (constSec κ ε ι (eoOpen n)) fun i => ⟨atE (s i : (Opre κ ε ι).obj (op U)).1 hU, ?_⟩⟩
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | e m' => obtain rfl : m' = n := hy; rfl
  | o m' =>
    obtain rfl : m' = n := hy
    exact ((sec_mem κ ε ι (s i)).2.1 m' hU).symm
  | infty => exact (hy : False).elim
  | c _ => exact (hy : False).elim
  | d _ => exact (hy : False).elim

/-- **At `o n`**: on `{o n}` the sections are elements of the field `K`. -/
theorem gen_o {K : Type} [Field K] (ι : D →+* K)
    {s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U)} {n : ℕ} (hU : o n ∈ U) :
    ∃ U', o n ∈ U' ∧ Gen κ ε ι U s U' := by
  have hle := oOpen_le hU
  refine ⟨oOpen n, (rfl : n = n), hle, ?_⟩
  refine ⟨m, exists_generatesLocally_of_field s (Opre_comm κ ε ι) (Over.mk (homOfLE hle))
    (odSec κ ε ι (oOpen n) (oOpen_c n) (oOpen_e n) (oOpen_i n))
    fun i => ⟨atO (s i : (Opre κ ε ι).obj (op U)).1 hU, ?_⟩⟩
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | o m' => obtain rfl : m' = n := hy; rfl
  | _ => exact (hy : False).elim

/-- **At `d n`**: on `{d n}` the sections are elements of the field `K`. -/
theorem gen_d {K : Type} [Field K] (ι : D →+* K)
    {s : Fin m → (PresheafOfModules.unit (Opre κ ε ι)).obj (op U)} {n : ℕ} (hU : d n ∈ U) :
    ∃ U', d n ∈ U' ∧ Gen κ ε ι U s U' := by
  have hle := dOpen_le hU
  refine ⟨dOpen n, (rfl : n = n), hle, ?_⟩
  refine ⟨m, exists_generatesLocally_of_field s (Opre_comm κ ε ι) (Over.mk (homOfLE hle))
    (odSec κ ε ι (dOpen n) (dOpen_c n) (dOpen_e n) (dOpen_i n))
    fun i => ⟨atD (s i : (Opre κ ε ι).obj (op U)).1 hU, ?_⟩⟩
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | d m' => obtain rfl : m' = n := hy; rfl
  | _ => exact (hy : False).elim

end Generic

/-! ### The node `c n` -/

section Node

/-- Evaluation of the sections over `W` at a point of `W`, a ring map. -/
def evalAt (W : Opens Xsp) {y : Pt} (hy : y ∈ W) : (Opre κ ε ι).obj (op W) →+* Val k D K y where
  toFun a := a.1 ⟨y, hy⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem c_mem_cOpen (n : ℕ) : c n ∈ cOpen n := (rfl : n = n)
theorem o_mem_cOpen (n : ℕ) : o n ∈ cOpen n := (rfl : n = n)
theorem d_mem_cOpen (n : ℕ) : d n ∈ cOpen n := (rfl : n = n)
theorem o_mem_oOpen (n : ℕ) : o n ∈ oOpen n := (rfl : n = n)
theorem d_mem_dOpen (n : ℕ) : d n ∈ dOpen n := (rfl : n = n)

/-- Sections over `{c n, o n, d n}` agree if they agree at `c n`. -/
theorem ext_cOpen {n : ℕ} {a b : (Opre κ ε ι).obj (op (cOpen n))}
    (h : evalAt κ ε ι _ (c_mem_cOpen n) a = evalAt κ ε ι _ (c_mem_cOpen n) b) : a = b := by
  have hCa := (a.2.1 n (c_mem_cOpen n))
  have hCb := (b.2.1 n (c_mem_cOpen n))
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | c m => obtain rfl : m = n := hy; exact h
  | o m =>
    obtain rfl : m = n := hy
    exact hCa.1.symm.trans ((congrArg (fun x : D × D => ι x.1) h).trans hCb.1)
  | d m =>
    obtain rfl : m = n := hy
    exact hCa.2.1.symm.trans ((congrArg (fun x : D × D => ι x.2) h).trans hCb.2.1)
  | infty => exact (hy : False).elim
  | e _ => exact (hy : False).elim

/-- Sections over `{o n}` agree if they agree at `o n`. -/
theorem ext_oOpen {n : ℕ} {a b : (Opre κ ε ι).obj (op (oOpen n))}
    (h : evalAt κ ε ι _ (o_mem_oOpen n) a = evalAt κ ε ι _ (o_mem_oOpen n) b) : a = b := by
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | o m => obtain rfl : m = n := hy; exact h
  | _ => exact (hy : False).elim

/-- Sections over `{d n}` agree if they agree at `d n`. -/
theorem ext_dOpen {n : ℕ} {a b : (Opre κ ε ι).obj (op (dOpen n))}
    (h : evalAt κ ε ι _ (d_mem_dOpen n) a = evalAt κ ε ι _ (d_mem_dOpen n) b) : a = b := by
  refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
  cases y with
  | d m => obtain rfl : m = n := hy; exact h
  | _ => exact (hy : False).elim

/-- The function with value `x` at the nodes and its two branches at `o`, `d`. -/
def nodeF (x : D × D) : (y : Pt) → Val k D K y
  | infty => 0
  | c _ => x
  | e _ => 0
  | o _ => ι x.1
  | d _ => ι x.2

/-- The section of `𝒪` over `{c n, o n, d n}` with value `x` at `c n`. -/
def cSec (n : ℕ) (x : D × D) (hx : ε x.1 = ε x.2) : (Opre κ ε ι).obj (op (cOpen n)) :=
  ⟨fun y => nodeF ι x y.1, fun _ _ => ⟨rfl, rfl, hx⟩, fun _ h => (h : False).elim,
    fun h => (h : False).elim⟩

theorem evalAt_cSec_c (n : ℕ) (x : D × D) (hx : ε x.1 = ε x.2) :
    evalAt κ ε ι _ (c_mem_cOpen n) (cSec κ ε ι n x hx) = x := rfl

/-- The diagonal `D → 𝒪({c n, o n, d n})`. -/
def diag (n : ℕ) : D →+* (Opre κ ε ι).obj (op (cOpen n)) where
  toFun p := cSec κ ε ι n (p, p) rfl
  map_one' := ext_cOpen κ ε ι rfl
  map_mul' _ _ := ext_cOpen κ ε ι rfl
  map_zero' := ext_cOpen κ ε ι rfl
  map_add' _ _ := ext_cOpen κ ε ι rfl

/-- **`𝒪({c n, o n, d n})` is noetherian** when `D` is: it is a `D`-submodule of `D × D` through
its value at the node. -/
theorem isNoetherianRing_cOpen [IsNoetherianRing D] (n : ℕ) :
    IsNoetherianRing ((Opre κ ε ι).obj (op (cOpen n))) := by
  let : Algebra D ((Opre κ ε ι).obj (op (cOpen n))) :=
    (diag κ ε ι n).toAlgebra' fun _ _ => Opre_comm κ ε ι _ _ _
  let f : (Opre κ ε ι).obj (op (cOpen n)) →ₗ[D] D × D :=
    { toFun := evalAt κ ε ι _ (c_mem_cOpen n)
      map_add' := map_add _
      map_smul' := fun p a => by
        change evalAt κ ε ι _ (c_mem_cOpen n) (diag κ ε ι n p * a) = _
        rw [map_mul]
        rfl }
  have hf : Function.Injective f := fun a b h => ext_cOpen κ ε ι h
  have : IsNoetherian D ((Opre κ ε ι).obj (op (cOpen n))) := isNoetherian_of_injective f hf
  exact isNoetherian_of_tower D this

end Node

/-! ### Local generators of the relations at the node `c n` -/

section NodeGen

variable {k D K : Type} [CommRing k] [CommRing D] [Field K] [Algebra D K]
  (κ : k →+* D) (ε : D →+* k)

/-- The relations among finitely many sections over `{c n, o n, d n}` are finitely generated. -/
theorem exists_gens_cOpen [IsNoetherianRing D] {U : Opens Xsp} {m : ℕ}
    (s : Fin m → (PresheafOfModules.unit (Opre κ ε (algebraMap D K))).obj (op U)) {n : ℕ}
    (hle : cOpen n ≤ U) :
    ∃ (N : ℕ) (gens : Fin N → (relationsPresheaf (PresheafOfModules.unit
        (Opre κ ε (algebraMap D K))) s).obj (op (Over.mk (homOfLE hle)))),
      ∀ r, ∃ c : Fin N → ((Over.forget U).op ⋙ Opre κ ε (algebraMap D K)).obj
          (op (Over.mk (homOfLE hle))),
        ∑ l, c l • gens l = r := by
  let A := (Opre κ ε (algebraMap D K)).obj (op (Over.mk (homOfLE hle)).left)
  have : IsNoetherianRing A := isNoetherianRing_cOpen κ ε (algebraMap D K) n
  let S := relationsSubmodule (PresheafOfModules.unit (Opre κ ε (algebraMap D K))) s
    (Over.mk (homOfLE hle))
  have h1 : IsNoetherian A (Fin m → A) := inferInstance
  have h2 : IsNoetherian A S := isNoetherian_submodule' (M := Fin m → A) S
  obtain ⟨N, gens, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian (⊤ : Submodule A S))
  refine ⟨N, gens, fun r => ?_⟩
  let r' : S := r
  have hr : r' ∈ Submodule.span A (Set.range gens) := by rw [hg]; trivial
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hr
  exact ⟨c, hc⟩

/-- **At the node `c n`**: over `{c n, o n, d n}` the relations are finitely generated, because
`𝒪({c n, o n, d n})` is noetherian, and they still generate over `{o n}` and `{d n}`, because
restriction to either point is a localisation at `(T, 0)`, resp. `(0, T)`. -/
theorem gen_c [IsNoetherianRing D] (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0)
    {U : Opens Xsp} {m : ℕ}
    {s : Fin m → (PresheafOfModules.unit (Opre κ ε (algebraMap D K))).obj (op U)} {n : ℕ}
    (hU : c n ∈ U) : ∃ U', c n ∈ U' ∧ Gen κ ε (algebraMap D K) U s U' := by
  let ι := algebraMap D K
  have hle := cOpen_le hU
  obtain ⟨N, gens, hgen⟩ := exists_gens_cOpen κ ε s hle
  refine ⟨cOpen n, c_mem_cOpen n, hle, N, gens, generatesLocally_of_forall_mem _ gens ?_⟩
  intro V f t x hx
  have hxc : x ∈ cOpen n := f.left.le hx
  cases x with
  | c n' =>
    have hn : n' = n := hxc
    subst n'
    refine ⟨V, 𝟙 V, hx, ?_⟩
    have hback := cOpen_le hx
    refine exists_sum_eq_of_localization s (Opre_comm κ ε ι) (𝟙 V ≫ f) gens hgen 1
      (by rw [map_one]; exact isUnit_one) (fun b => ⟨(Opre κ ε ι).map (homOfLE hback).op b, 0,
        by rw [pow_zero, mul_one]; rfl⟩) (fun a h => ?_) _
    have : (Opre κ ε ι).map (homOfLE hback).op ((Opre κ ε ι).map (𝟙 V ≫ f).left.op a) = a := rfl
    rw [one_mul, ← this, h, map_zero]
  | o n' =>
    have hn : n' = n := hxc
    subst n'
    have hoV := oOpen_le hx
    let W : Over U := Over.mk (homOfLE (hoV.trans V.hom.le))
    let g : W ⟶ V := Over.homMk (homOfLE hoV) (Subsingleton.elim _ _)
    refine ⟨W, g, o_mem_oOpen n, ?_⟩
    have hev : ∀ a, evalAt κ ε ι (oOpen n) (o_mem_oOpen n) ((Opre κ ε ι).map (g ≫ f).left.op a) =
        evalAt κ ε ι (cOpen n) (o_mem_cOpen n) a := fun _ => rfl
    let τ := cSec κ ε ι n (T, 0) (by change ε T = ε 0; rw [hT, map_zero])
    refine exists_sum_eq_of_localization s (Opre_comm κ ε ι) (g ≫ f) gens hgen τ ?_ ?_ ?_ _
    · have : (Opre κ ε ι).map (g ≫ f).left.op τ =
          odSec κ ε ι (oOpen n) (oOpen_c n) (oOpen_e n) (oOpen_i n) (ι T) :=
        ext_oOpen κ ε ι rfl
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit T).map _
    · intro b
      obtain ⟨⟨p, q⟩, hp⟩ := IsLocalization.surj (Submonoid.powers T)
        (evalAt κ ε ι (oOpen n) (o_mem_oOpen n) b)
      obtain ⟨M, hM⟩ := q.2
      refine ⟨cSec κ ε ι n (p, κ (ε p)) (by change ε p = ε (κ (ε p)); rw [hεκ]), M,
        ext_oOpen κ ε ι ?_⟩
      rw [map_mul, map_pow, hev, hev]
      change ι p = evalAt κ ε ι (oOpen n) (o_mem_oOpen n) b * ι T ^ M
      have hM' : T ^ M = q := hM
      rw [← map_pow, hM']
      exact hp.symm
    · intro a h
      have h0 := congrArg (evalAt κ ε ι (oOpen n) (o_mem_oOpen n)) h
      rw [hev, map_zero] at h0
      have hc1 : (evalAt κ ε ι (cOpen n) (c_mem_cOpen n) a).1 = 0 :=
        hι ((a.2.1 n (c_mem_cOpen n)).1.trans (h0.trans (map_zero ι).symm))
      refine ext_cOpen κ ε ι ?_
      rw [map_mul, map_zero]
      refine Prod.ext ?_ ?_
      · change T * (evalAt κ ε ι (cOpen n) (c_mem_cOpen n) a).1 = 0
        rw [hc1, mul_zero]
      · exact zero_mul _
  | d n' =>
    have hn : n' = n := hxc
    subst n'
    have hdV := dOpen_le hx
    let W : Over U := Over.mk (homOfLE (hdV.trans V.hom.le))
    let g : W ⟶ V := Over.homMk (homOfLE hdV) (Subsingleton.elim _ _)
    refine ⟨W, g, d_mem_dOpen n, ?_⟩
    have hev : ∀ a, evalAt κ ε ι (dOpen n) (d_mem_dOpen n) ((Opre κ ε ι).map (g ≫ f).left.op a) =
        evalAt κ ε ι (cOpen n) (d_mem_cOpen n) a := fun _ => rfl
    let τ := cSec κ ε ι n (0, T) (by change ε 0 = ε T; rw [hT, map_zero])
    refine exists_sum_eq_of_localization s (Opre_comm κ ε ι) (g ≫ f) gens hgen τ ?_ ?_ ?_ _
    · have : (Opre κ ε ι).map (g ≫ f).left.op τ =
          odSec κ ε ι (dOpen n) (dOpen_c n) (dOpen_e n) (dOpen_i n) (ι T) :=
        ext_dOpen κ ε ι rfl
      rw [this]
      exact (IsLocalization.Away.algebraMap_isUnit T).map _
    · intro b
      obtain ⟨⟨p, q⟩, hp⟩ := IsLocalization.surj (Submonoid.powers T)
        (evalAt κ ε ι (dOpen n) (d_mem_dOpen n) b)
      obtain ⟨M, hM⟩ := q.2
      refine ⟨cSec κ ε ι n (κ (ε p), p) (by change ε (κ (ε p)) = ε p; rw [hεκ]), M,
        ext_dOpen κ ε ι ?_⟩
      rw [map_mul, map_pow, hev, hev]
      change ι p = evalAt κ ε ι (dOpen n) (d_mem_dOpen n) b * ι T ^ M
      have hM' : T ^ M = q := hM
      rw [← map_pow, hM']
      exact hp.symm
    · intro a h
      have h0 := congrArg (evalAt κ ε ι (dOpen n) (d_mem_dOpen n)) h
      rw [hev, map_zero] at h0
      have hc2 : (evalAt κ ε ι (cOpen n) (c_mem_cOpen n) a).2 = 0 :=
        hι ((a.2.1 n (c_mem_cOpen n)).2.1.trans (h0.trans (map_zero ι).symm))
      refine ext_cOpen κ ε ι ?_
      rw [map_mul, map_zero]
      refine Prod.ext ?_ ?_
      · exact zero_mul _
      · change T * (evalAt κ ε ι (cOpen n) (c_mem_cOpen n) a).2 = 0
        rw [hc2, mul_zero]
  | infty => exact (hxc : False).elim
  | e _ => exact (hxc : False).elim

end NodeGen

/-! ### Coherence of `𝒪` -/

section Coherence

variable {k D K : Type} [Field k] [CommRing D] [Field K] [Algebra D K] [IsNoetherianRing D]
  (κ : k →+* D) (ε : D →+* k)

/-- Every point of `U` has a neighbourhood on which the relations among `s` are finitely
generated. -/
theorem exists_gen (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0)
    {U : Opens Xsp} {m : ℕ}
    (s : Fin m → (PresheafOfModules.unit (Opre κ ε (algebraMap D K))).obj (op U)) (x : Pt)
    (hx : x ∈ U) : ∃ U', x ∈ U' ∧ Gen κ ε (algebraMap D K) U s U' := by
  cases x with
  | infty => exact gen_infty (algebraMap D K) κ ε hx
  | c n => exact gen_c κ ε T hεκ hι hT hx
  | e n => exact gen_e (algebraMap D K) κ ε hx
  | o n => exact gen_o κ ε (algebraMap D K) hx
  | d n => exact gen_d κ ε (algebraMap D K) hx

/-- **`𝒪` is coherent** (Stacks 01BV): it is of finite type, generated by `1`, and the relations
among finitely many of its sections are, near every point, finitely generated. -/
theorem isCoherent_O (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0) :
    Stacks.SheafOfModules.IsCoherent (SheafOfModules.unit (Osheaf κ ε (algebraMap D K))) := by
  rw [← Stacks.SheafOfModules.Site.isCoherent_iff_isCoherent_opens]
  refine Stacks.SheafOfModules.Site.isCoherent_of_isFiniteTypeSections ?_ ?_
  · refine ⟨PUnit, fun _ => ⊤, fun V => ?_,
      fun _ => ⟨1, fun _ => (1 : (Opre κ ε (algebraMap D K)).obj (op ⊤)), ?_⟩⟩
    · convert (Opens.grothendieckTopology Xsp).top_mem V
      ext W g
      simp only [Sieve.top_apply, iff_true]
      exact ⟨⟨⟩, ⟨homOfLE le_top⟩⟩
    · intro V f t
      refine ⟨⊤, (Opens.grothendieckTopology Xsp).top_mem V, fun W g _ =>
        ⟨fun _ => (SheafOfModules.unit (Osheaf κ ε (algebraMap D K))).val.restrictₛₗ g.op t, ?_⟩⟩
      rw [Fin.sum_univ_one]
      change _ * (Opre κ ε (algebraMap D K)).map (g ≫ f).op 1 = _
      rw [map_one]
      exact mul_one ((Opre κ ε (algebraMap D K)).map g.op t)
  · intro U m s
    refine isFiniteTypeSections_of_forall_mem _ fun x hx => ?_
    obtain ⟨U', hxU', hU', N, v, hv⟩ := exists_gen κ ε T hεκ hι hT s x hx
    exact ⟨U', hU', hxU', N, v, hv⟩

end Coherence

/-! ### The stalks -/

/-- A stalk is noetherian if it is the image of a noetherian ring mapping to the sections over
one neighbourhood `V` of the point, through which every germ factors. -/
theorem isNoetherianRing_stalk_of {F : TopCat.Presheaf RingCat Xsp} {x : Xsp} {A : Type}
    [Ring A] [IsNoetherianRing A] (V : Opens Xsp) (hx : x ∈ V) (φ : A →+* F.obj (op V))
    (h : ∀ (W : Opens Xsp) (hW : x ∈ W) (s : F.obj (op W)),
      ∃ a, F.germ W x hW s = F.germ V x hx (φ a)) :
    IsNoetherianRing (F.stalk x) := by
  refine isNoetherianRing_of_surjective A (F.stalk x) ((F.germ V x hx).hom.comp φ) fun t => ?_
  obtain ⟨W, hW, s, rfl⟩ := F.exists_germ_eq t
  obtain ⟨a, ha⟩ := h W hW s
  exact ⟨a, ha.symm⟩

variable {k D K : Type} [Field k] [CommRing D] [Field K] [IsNoetherianRing D]
  (κ : k →+* D) (ε : D →+* k) (ι : D →+* K)

/-- **The stalks of `𝒪` are noetherian**: `k` at `infty` and at `e n`, a quotient of the
noetherian `𝒪({c n, o n, d n})` at `c n`, and `K` at `o n` and `d n`. -/
theorem isNoetherianRing_stalk (x : Xsp) : IsNoetherianRing ((Opre κ ε ι).stalk x) := by
  cases x with
  | infty =>
    refine isNoetherianRing_stalk_of ⊤ trivial (constSec κ ε ι ⊤) fun W hW s => ?_
    obtain ⟨N, hN⟩ := s.2.2.2 hW
    obtain ⟨M, hM⟩ := exists_basicOpen_le hW
    have hle : basicOpen (max N M) ≤ W := le_trans (basic_anti (le_max_right N M)) hM
    refine ⟨atInf s.1 hW, ?_⟩
    have hB : (infty : Xsp) ∈ basicOpen (max N M) := trivial
    rw [← TopCat.Presheaf.germ_res_apply (Opre κ ε ι) (homOfLE hle) (infty : Xsp) hB s,
      ← TopCat.Presheaf.germ_res_apply (Opre κ ε ι) (homOfLE (le_top : basicOpen (max N M) ≤ ⊤))
        (infty : Xsp) hB]
    congr 1
    refine Subtype.ext (funext fun y => ?_)
    exact hN ⟨y.1, hle y.2⟩ (inBasic_anti (le_max_left N M) _ y.2)
  | c n =>
    have := isNoetherianRing_cOpen κ ε ι n
    refine isNoetherianRing_stalk_of (cOpen n) (c_mem_cOpen n) (RingHom.id _) fun W hW s =>
      ⟨(Opre κ ε ι).map (homOfLE (cOpen_le hW)).op s, ?_⟩
    exact (TopCat.Presheaf.germ_res_apply _ (homOfLE (cOpen_le hW)) _ _ s).symm
  | e n =>
    refine isNoetherianRing_stalk_of (eoOpen n) (rfl : n = n) (constSec κ ε ι (eoOpen n))
      fun W hW s => ⟨atE s.1 hW, ?_⟩
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (eoOpen_le hW)) _ (rfl : n = n) s]
    congr 1
    refine Subtype.ext (funext fun ⟨y, hy⟩ => ?_)
    cases y with
    | e m' => have h : m' = n := hy; subst m'; rfl
    | o m' =>
      have h : m' = n := hy
      subst m'
      exact (s.2.2.1 n hW).symm
    | infty => exact (hy : False).elim
    | c _ => exact (hy : False).elim
    | d _ => exact (hy : False).elim
  | o n =>
    refine isNoetherianRing_stalk_of (oOpen n) (o_mem_oOpen n)
      (odSec κ ε ι (oOpen n) (oOpen_c n) (oOpen_e n) (oOpen_i n)) fun W hW s => ⟨atO s.1 hW, ?_⟩
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (oOpen_le hW)) _ (o_mem_oOpen n) s]
    congr 1
    exact ext_oOpen κ ε ι rfl
  | d n =>
    refine isNoetherianRing_stalk_of (dOpen n) (d_mem_dOpen n)
      (odSec κ ε ι (dOpen n) (dOpen_c n) (dOpen_e n) (dOpen_i n)) fun W hW s => ⟨atD s.1 hW, ?_⟩
    rw [← TopCat.Presheaf.germ_res_apply _ (homOfLE (dOpen_le hW)) _ (d_mem_dOpen n) s]
    congr 1
    exact ext_dOpen κ ε ι rfl

end Grothendieck.Folder55LemmaB
