module

public import Grothendieck.Folder55Coherent
public import Mathlib.RingTheory.LaurentSeries
public import Mathlib.RingTheory.PowerSeries.Ideal

/-!
# Folder 55, page 13: the Ideals `𝒢_j` are coherent, and Lemme B fails

`Gsub j` is the Ideal `𝒢_j` of `Grothendieck.Folder55LemmaB.G` as a sub-sheaf of modules of
`𝒪` (Mathlib's `SheafOfModules.Submodule`), and `Gmod j` the sheaf of modules it defines.

## Main results

* `Gmod_isFiniteType`: `𝒢_j` is zero on `B_j` (`Gmod_gen_basic`), generated by `1` on
  `{e n, o n}` and `{o n}` (`Gmod_gen_one`) and by the section `(T, 0)` on `{c n, o n, d n}`
  (`Gmod_gen_node`), for `n < j`.
* `Gmod_isCoherent`: a sub-sheaf of modules of finite type of the coherent `𝒪` is coherent
  (`Stacks.SheafOfModules.isCoherent_of_mono`).
* `lemmeB_counterexample`: over `k⟦X⟧ ⊂ k⸨X⸩`, all the hypotheses of Lemme B hold that the
  page's argument uses, (i), (ii), (iv), and (v) for `𝒪` at `infty`, and the increasing sequence
  of coherent Ideals `𝒢_j` is not stationary.

## References

* A. Grothendieck, folder 55, p. 13 (Lemme B)
-/

@[expose] public section


open CategoryTheory TopologicalSpace Opposite Stacks.SheafOfModules Grothendieck.Folder55Generation

namespace Grothendieck.Folder55LemmaB
open Pt

variable {k D K : Type} [CommRing k] [CommRing D] [CommRing K] (κ : k →+* D) (ε : D →+* k)
  (ι : D →+* K)

/-! ### The Ideals `𝒢_j` as sheaves of modules -/

theorem G_zero_mem (j : ℕ) (U : Opens Xsp) : (0 : Sec k D K U) ∈ (G κ ε ι j).sections U :=
  ⟨O_zero_mem κ ε ι U, fun _ _ => rfl⟩

/-- **The Ideal `𝒢_j` of `𝒪`, as a sub-sheaf of modules of `𝒪`.** -/
def Gsub (j : ℕ) : (SheafOfModules.unit (Osheaf κ ε ι)).Submodule where
  obj X :=
    { carrier := {a : (Opre κ ε ι).obj X | a.1 ∈ (G κ ε ι j).sections X.unop}
      add_mem' := fun ha hb => G_add_mem κ ε ι ha hb
      zero_mem' := G_zero_mem κ ε ι j X.unop
      smul_mem' := fun r _ ha => G_mul_mem κ ε ι r.2 ha }
  map {X Y} f a ha := (G κ ε ι j).restrict f.unop.le ha
  isSheaf X s hs := by
    rw [Opens.mem_grothendieckTopology] at hs
    refine (G κ ε ι j).isLocal X.unop _ fun x hx => ?_
    obtain ⟨V, f, hf, hxV⟩ := hs x hx
    exact ⟨V, f.le, hxV, hf⟩

/-- The sheaf of modules `𝒢_j`. -/
noncomputable abbrev Gmod (j : ℕ) := (Gsub κ ε ι j).toSheafOfModules

theorem Gmod_ext {j : ℕ} {V : Opens Xsp} {a b : (Gmod κ ε ι j).val.obj (op V)}
    (h : ∀ y : V, a.1.1 y = b.1.1 y) : a = b :=
  Subtype.ext (Subtype.ext (funext h))

/-- **On `B_j`, `𝒢_j` is zero**: the empty family generates it. -/
theorem Gmod_gen_basic (j : ℕ) :
    GeneratesLocally (Opens.grothendieckTopology Xsp) (Gmod κ ε ι j).val
      (Fin.elim0 : Fin 0 → (Gmod κ ε ι j).val.obj (op (basicOpen j))) := by
  intro V f t
  refine ⟨⊤, (Opens.grothendieckTopology Xsp).top_mem V, fun W g _ => ⟨Fin.elim0, ?_⟩⟩
  rw [Finset.univ_eq_empty, Finset.sum_empty]
  refine Gmod_ext κ ε ι fun y => ?_
  exact (t.2.2 ⟨y.1, g.le y.2⟩ (f.le (g.le y.2))).symm

/-- **Away from `B_j`, `𝒢_j` is `𝒪`**: it is generated by `1`. -/
theorem Gmod_gen_one (j : ℕ) {U' : Opens Xsp} (hU' : ∀ y ∈ U', ¬ InBasic j y) :
    GeneratesLocally (Opens.grothendieckTopology Xsp) (Gmod κ ε ι j).val
      (fun _ : Fin 1 => (⟨(1 : (Opre κ ε ι).obj (op U')), O_one_mem κ ε ι U',
        fun y hy => (hU' y.1 y.2 hy).elim⟩ :
        (Gmod κ ε ι j).val.obj (op U'))) := by
  intro V f t
  refine ⟨⊤, (Opens.grothendieckTopology Xsp).top_mem V, fun W g _ =>
    ⟨fun _ => ((Gmod κ ε ι j).val.restrictₛₗ g.op t).1, ?_⟩⟩
  rw [Fin.sum_univ_one]
  refine Gmod_ext κ ε ι fun y => ?_
  exact mul_one _

section Node

variable {k D K : Type} [CommRing k] [CommRing D] [Field K] [Algebra D K]
  (κ : k →+* D) (ε : D →+* k)

/-- The generator `(T, 0)` of `𝒢_j` at a node `c m`, `m < j`. -/
def Gnode (T : D) (hT : ε T = 0) (j : ℕ) {m : ℕ} (hm : m < j) :
    (Gmod κ ε (algebraMap D K) j).val.obj (op (cOpen m)) :=
  ⟨cSec κ ε (algebraMap D K) m (T, 0) (by change ε T = ε 0; rw [hT, map_zero]),
    (cSec κ ε (algebraMap D K) m (T, 0) _).2, fun ⟨y, hy⟩ hb => by
      cases y with
      | c m' =>
        have h1 : m' = m := hy
        have h2 : j ≤ m' := hb
        omega
      | o m' =>
        have h1 : m' = m := hy
        have h2 : j ≤ m' := hb
        omega
      | d m' => exact map_zero (algebraMap D K)
      | infty => exact (hy : False).elim
      | e _ => exact (hy : False).elim⟩

/-- **At a node `c m`, `m < j`, `𝒢_j` is generated by `(T, 0)`**, the generator of the ideal
of the second branch: a section vanishing at `d m` has second branch `0`, and first branch with
constant term `0`, a multiple of `T`. -/
theorem Gmod_gen_node (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0)
    (hTdvd : ∀ p, ε p = 0 → ∃ p', p = T * p') (j : ℕ) {n : ℕ} (hm : n < j) :
    GeneratesLocally (Opens.grothendieckTopology Xsp) (Gmod κ ε (algebraMap D K) j).val
      (fun _ : Fin 1 => Gnode κ ε T hT j hm) := by
  let ι := algebraMap D K
  refine generatesLocally_of_forall_mem' _ _ fun V f t x hx => ?_
  have hxc : x ∈ cOpen n := f.le hx
  cases x with
  | c n' =>
    have hn : n' = n := hxc
    subst n'
    have hcV := cOpen_le hx
    refine ⟨cOpen n, homOfLE hcV, c_mem_cOpen n, ?_⟩
    let t' := (Gmod κ ε ι j).val.restrictₛₗ (homOfLE hcV).op t
    let pq := evalAt κ ε ι _ (c_mem_cOpen n) t'.1
    have hC := t'.1.2.1 n (c_mem_cOpen n)
    have hq : pq.2 = 0 := hι ((hC.2.1).trans ((t'.2.2 ⟨d n, d_mem_cOpen n⟩ trivial).trans
      (map_zero ι).symm))
    have hp : ε pq.1 = 0 := by
      have h := hC.2.2
      change ε pq.1 = ε pq.2 at h
      rw [h, hq, map_zero]
    obtain ⟨p', hp'⟩ := hTdvd _ hp
    refine ⟨fun _ => cSec κ ε ι n (p', κ (ε p')) (by change ε p' = ε (κ (ε p')); rw [hεκ]), ?_⟩
    rw [Fin.sum_univ_one]
    refine Subtype.ext (ext_cOpen κ ε ι ?_)
    refine Prod.ext ?_ ?_
    · change p' * T = pq.1
      rw [hp', mul_comm]
    · change κ (ε p') * 0 = pq.2
      rw [hq, mul_zero]
  | o n' =>
    have hn : n' = n := hxc
    subst n'
    have hoV := oOpen_le hx
    refine ⟨oOpen n, homOfLE hoV, o_mem_oOpen n, ?_⟩
    let t' := (Gmod κ ε ι j).val.restrictₛₗ (homOfLE hoV).op t
    let β := evalAt κ ε ι _ (o_mem_oOpen n) t'.1
    refine ⟨fun _ => odSec κ ε ι (oOpen n) (oOpen_c n) (oOpen_e n) (oOpen_i n) (β / ι T), ?_⟩
    rw [Fin.sum_univ_one]
    refine Subtype.ext (ext_oOpen κ ε ι ?_)
    change β / ι T * ι T = β
    exact div_mul_cancel₀ β (IsLocalization.Away.algebraMap_isUnit T).ne_zero
  | d n' =>
    have hn : n' = n := hxc
    subst n'
    have hdV := dOpen_le hx
    refine ⟨dOpen n, homOfLE hdV, d_mem_dOpen n, ⟨fun _ => 0, ?_⟩⟩
    rw [Fin.sum_univ_one, zero_smul]
    refine Gmod_ext κ ε ι fun ⟨y, hy⟩ => ?_
    cases y with
    | d m' =>
      have h1 : m' = n := hy
      subst m'
      exact (t.2.2 ⟨d n, hdV (d_mem_dOpen n)⟩ trivial).symm
    | _ => exact (hy : False).elim
  | infty => exact (hxc : False).elim
  | e _ => exact (hxc : False).elim

theorem not_inBasic_eoOpen {j n : ℕ} (h : n < j) : ∀ y ∈ eoOpen n, ¬ InBasic j y := by
  intro y hy hb
  cases y with
  | e m => have h1 : m = n := hy; have h2 : j ≤ m := hb; omega
  | o m => have h1 : m = n := hy; have h2 : j ≤ m := hb; omega
  | _ => exact (hy : False)

theorem not_inBasic_oOpen {j n : ℕ} (h : n < j) : ∀ y ∈ oOpen n, ¬ InBasic j y := by
  intro y hy hb
  cases y with
  | o m => have h1 : m = n := hy; have h2 : j ≤ m := hb; omega
  | _ => exact (hy : False)

/-- **`𝒢_j` is of finite type**: zero on `B_j`, generated by `1` on `{e n, o n}` and `{o n}`
and by `(T, 0)` on `{c n, o n, d n}`, for `n < j`. -/
theorem Gmod_isFiniteType (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0)
    (hTdvd : ∀ p, ε p = 0 → ∃ p', p = T * p') (j : ℕ) :
    (Gmod κ ε (algebraMap D K) j).IsFiniteType := by
  refine Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeSections' _
    (isFiniteTypeSections_of_forall_mem' _ fun x => ?_)
  have basic : InBasic j x → ∃ U' : Opens Xsp, x ∈ U' ∧ ∃ (N : ℕ)
      (s : Fin N → (Gmod κ ε (algebraMap D K) j).val.obj (op U')),
      GeneratesLocally (Opens.grothendieckTopology Xsp) (Gmod κ ε (algebraMap D K) j).val s :=
    fun hx => ⟨basicOpen j, hx, 0, Fin.elim0, Gmod_gen_basic κ ε (algebraMap D K) j⟩
  cases x with
  | infty => exact basic trivial
  | d n => exact basic trivial
  | c n =>
    by_cases h : j ≤ n
    · exact basic h
    · exact ⟨cOpen n, c_mem_cOpen n, 1, _,
        Gmod_gen_node κ ε T hεκ hι hT hTdvd j (Nat.lt_of_not_le h)⟩
  | e n =>
    by_cases h : j ≤ n
    · exact basic h
    · exact ⟨eoOpen n, (rfl : n = n), 1, _,
        Gmod_gen_one κ ε (algebraMap D K) j (not_inBasic_eoOpen (Nat.lt_of_not_le h))⟩
  | o n =>
    by_cases h : j ≤ n
    · exact basic h
    · exact ⟨oOpen n, o_mem_oOpen n, 1, _,
        Gmod_gen_one κ ε (algebraMap D K) j (not_inBasic_oOpen (Nat.lt_of_not_le h))⟩

end Node

/-- **`𝒢_j` is coherent**: a sub-sheaf of modules of finite type of the coherent `𝒪`
(Stacks 01BY). -/
theorem Gmod_isCoherent {k D K : Type} [Field k] [CommRing D] [Field K] [Algebra D K]
    [IsNoetherianRing D] (κ : k →+* D) (ε : D →+* k) (T : D) [IsLocalization.Away T K]
    (hεκ : ∀ a, ε (κ a) = a) (hι : Function.Injective (algebraMap D K)) (hT : ε T = 0)
    (hTdvd : ∀ p, ε p = 0 → ∃ p', p = T * p') (j : ℕ) :
    Stacks.SheafOfModules.IsCoherent (Gmod κ ε (algebraMap D K) j) := by
  have := isCoherent_O κ ε T hεκ hι hT
  have := Gmod_isFiniteType κ ε T hεκ hι hT hTdvd j
  exact Stacks.SheafOfModules.isCoherent_of_mono (Gsub κ ε (algebraMap D K) j).ι


/-! ### The counterexample over `k⟦X⟧ ⊂ k⸨X⸩` -/

section PowerSeries

variable (k : Type) [Field k]

/-- The constants `k → k⟦X⟧`. -/
noncomputable abbrev κ₀ : k →+* PowerSeries k := PowerSeries.C

/-- The constant term `k⟦X⟧ → k`. -/
noncomputable abbrev ε₀ : PowerSeries k →+* k := PowerSeries.constantCoeff

/-- The inclusion `k⟦X⟧ → k⸨X⸩`. -/
noncomputable abbrev ι₀ : PowerSeries k →+* LaurentSeries k :=
  algebraMap (PowerSeries k) (LaurentSeries k)

theorem ε₀_κ₀ (a : k) : ε₀ k (κ₀ k a) = a := PowerSeries.constantCoeff_C a

theorem ι₀_injective : Function.Injective (ι₀ k) :=
  FaithfulSMul.algebraMap_injective (PowerSeries k) (LaurentSeries k)

theorem ε₀_X : ε₀ k PowerSeries.X = 0 := PowerSeries.constantCoeff_X

theorem X_dvd_of_ε₀ (p : PowerSeries k) (h : ε₀ k p = 0) : ∃ p', p = PowerSeries.X * p' :=
  PowerSeries.X_dvd_iff.2 h

/-- **Lemme B of folder 55, page 13, is false for ringed spaces.** With `k` a field,
`D = k⟦X⟧`, `K = k⸨X⸩`: the space `Xsp` is quasi-compact, its structure sheaf `𝒪` is coherent with
noetherian stalks, and the identity principle holds for `𝒪` at `infty` on the fundamental system
`B_M`; the Ideals `𝒢_j` are coherent and increase, and the sequence is not stationary. -/
theorem lemmeB_counterexample :
    CompactSpace Xsp ∧
      Stacks.SheafOfModules.IsCoherent (SheafOfModules.unit (Osheaf (κ₀ k) (ε₀ k) (ι₀ k))) ∧
      (∀ x : Xsp, IsNoetherianRing ((Opre (κ₀ k) (ε₀ k) (ι₀ k)).stalk x)) ∧
      (∀ j, Stacks.SheafOfModules.IsCoherent (Gmod (κ₀ k) (ε₀ k) (ι₀ k) j)) ∧
      (∀ M {s : Sec k (PowerSeries k) (LaurentSeries k) (basicOpen M)},
        s ∈ (O (κ₀ k) (ε₀ k) (ι₀ k)).sections (basicOpen M) →
        ∀ {W : Opens Xsp}, (infty : Xsp) ∈ W → ∀ hWM : W ≤ basicOpen M,
          (∀ y : W, s ⟨y.1, hWM y.2⟩ = 0) → s = 0) ∧
      Monotone (G (κ₀ k) (ε₀ k) (ι₀ k)) ∧
      ¬ ∃ j₀, ∀ j ≥ j₀, G (κ₀ k) (ε₀ k) (ι₀ k) j = G (κ₀ k) (ε₀ k) (ι₀ k) j₀ :=
  ⟨inferInstanceAs (CompactSpace Pt),
    isCoherent_O (κ₀ k) (ε₀ k) PowerSeries.X (ε₀_κ₀ k) (ι₀_injective k) (ε₀_X k),
    isNoetherianRing_stalk (κ₀ k) (ε₀ k) (ι₀ k),
    Gmod_isCoherent (κ₀ k) (ε₀ k) PowerSeries.X (ε₀_κ₀ k) (ι₀_injective k) (ε₀_X k)
      (X_dvd_of_ε₀ k),
    fun M _ hs _ hW hWM h0 =>
      identity_principle (κ₀ k) (ε₀ k) (ι₀ k) (ε₀_κ₀ k) (ι₀_injective k) M hs hW hWM h0,
    G_mono _ _ _, G_not_stationary _ _ _⟩

end PowerSeries

end Grothendieck.Folder55LemmaB
